{
  "name": "overmatch-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "node scripts/embed-host.mjs --check && wrangler types src/worker-configuration.d.ts > /dev/null && tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run && vitest run --config vitest.ec2.config.ts",
    "pretest": "node scripts/embed-host.mjs --check",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
