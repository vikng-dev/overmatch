{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts"]
}
