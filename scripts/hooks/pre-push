#!/bin/sh
# pre-push — the git-lfs upload, and NOTHING ELSE.
#
# This hook is the ONLY git-lfs transport: `core.hooksPath` replaces `.git/hooks`, so the pre-push
# hook git-lfs installs there never runs, and without the line below a push ships the pointers but
# not the objects (CI then dies at "Git LFS pull (R2)" with "object not found" — the alpha.9
# outage). NEVER BYPASS WITH `git push --no-verify`. Recovery from a bypassed push requires
# `git lfs push --all origin`; the plain per-branch form computes an empty delta and uploads
# nothing.
#
# Every verdict this hook used to reach — fmt, clippy, the asset door — is now CI's, post-hoc, on
# the pushed commit. At one to two developers and no players, a local gate that delays the push by
# minutes to pre-empt a red CI badge is the expensive way to learn the same thing.
#
# `git lfs pre-push` reads the ref list from STDIN; the hook must therefore pass its own stdin and
# arguments through untouched.
set -e

echo "pre-push ▸ git lfs pre-push"
git lfs pre-push "$@"
