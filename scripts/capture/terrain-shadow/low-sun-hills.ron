// From the bay, after scripts/serial-cargo build --features dev_ui,bitprobe --bin overmatch:
// /usr/bin/lockf -k -t 10800 /tmp/overmatch-cargo.lock env OVERMATCH_UNATTENDED=1 OVERMATCH_WINDOW=hidden OVERMATCH_MUTE=1 OVERMATCH_CAPTURE=scripts/capture/terrain-shadow/low-sun-hills.ron target/debug/overmatch --offline
// The hills' baked shadows under a 3° sun across the map, near and past the sun's cascade range,
// from high over the north-east.
(
    frames: (
        out: "target/capture/terrain-shadow/low-sun-hills.png",
        at: [12.0],
        size: (1280, 720), scale_factor: 1.0, ui: false, gizmos: false, step_s: 0.015625,
        camera: Pose(eye: (60.0, 120.0, 260.0), look: (-330.0, 30.0, -80.0)),
    ),
    scene: (sun_elevation_deg: 3.0),
)
