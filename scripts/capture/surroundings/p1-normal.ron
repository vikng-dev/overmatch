// From the bay, after scripts/serial-cargo build --features dev_ui,bitprobe --bin overmatch:
// /usr/bin/lockf -k -t 10800 /tmp/overmatch-cargo.lock env OVERMATCH_START=599.9,-599.9,195 OVERMATCH_UNATTENDED=1 OVERMATCH_WINDOW=hidden OVERMATCH_MUTE=1 OVERMATCH_CAPTURE=scripts/capture/surroundings/p1-normal.ron target/debug/overmatch --offline
// Sky and horizon survey: a third-person height (12 m behind, 4.5 m above the tank at the "mud" spot),
// looking 150 m ahead to the south edge.
(frames: (out: "target/capture/sky/p1-normal.png", at: [12.0], size: (1280, 720), scale_factor: 1.0, ui: false, gizmos: false, step_s: 0.015625, camera: Pose(eye: (603.0, 16.6, -588.3), look: (561.1, 12.0, -744.8))))
