// From the bay, after scripts/serial-cargo build --features dev_ui,bitprobe --bin overmatch:
// /usr/bin/lockf -k -t 10800 /tmp/overmatch-cargo.lock env OVERMATCH_START=599.9,-599.9,195 OVERMATCH_UNATTENDED=1 OVERMATCH_WINDOW=hidden OVERMATCH_MUTE=1 OVERMATCH_CAPTURE=scripts/capture/surroundings/p2-sight.ron target/debug/overmatch --offline
// Sky and horizon survey: the gunner optic from the same spot, facing the south edge.
(frames: (out: "target/capture/sky/p2-sight.png", at: [12.0], size: (1280, 720), scale_factor: 1.0, ui: false, gizmos: false, sight: true, step_s: 0.015625))
