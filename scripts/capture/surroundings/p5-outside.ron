// From the bay, after scripts/serial-cargo build --features dev_ui,bitprobe --bin overmatch:
// /usr/bin/lockf -k -t 10800 /tmp/overmatch-cargo.lock env -u OVERMATCH_START OVERMATCH_UNATTENDED=1 OVERMATCH_WINDOW=hidden OVERMATCH_MUTE=1 OVERMATCH_CAPTURE=scripts/capture/surroundings/p5-outside.ron target/debug/overmatch --offline
// Sky and horizon survey: a free pose 150 m outside the east edge, looking back at the map's cut.
(frames: (out: "target/capture/sky/p5-outside.png", at: [12.0], size: (1280, 720), scale_factor: 1.0, ui: false, gizmos: false, step_s: 0.015625, camera: Pose(eye: (900.0, 45.0, 120.0), look: (700.0, 10.0, -60.0))))
