<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.overmatch.target-sweep</string>

    <!-- Run scripts/disk/sweep.sh through /bin/sh. cargo-sweep lives in ~/.cargo/bin,
         which a launchd agent does not inherit on PATH, so the script calls tools by the
         names launchd's minimal environment can resolve — and we widen PATH here too. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/Yan/github/vikng-dev/overmatch/scripts/disk/sweep.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/Yan/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every 6 h; sweep.sh itself exits unless a Claude Code session is running. -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>StandardOutPath</key>
    <string>/tmp/overmatch-target-sweep.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/overmatch-target-sweep.log</string>
</dict>
</plist>
