// The 8.8 cm KwK 36: every round it chambers and the muzzle speed it fires each at, its
// single-shot mechanism and its report.
// The file's fields are `src/guns.rs`'s module doc.
(
    names: [
        ("8.8 cm KwK 36 L/56", Measured("en.wikipedia.org/wiki/8.8_cm_KwK_36")),
    ],
    caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
    ammunition: {
        "88mm_HE": (muzzle_speed: (820.0, Derived("CITED Brit43 pp.91-92, E9-369A and TME30:
            2,690 ft/s = 819.9 m/s, rounded"))),
        "88mm_APHE_ring": (muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank
            1942-45, Osprey New Vanguard 5 (1993), p.17"))),
        "88mm_AP": (muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45,
            Osprey New Vanguard 5 (1993), p.17"))),
        "88mm_APCR": (muzzle_speed: (930.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45,
            Osprey New Vanguard 5 (1993), p.17"))),
    },
    // One round per trigger edge; the reload is the mount's.
    mechanism: Single,
    // Five takes of the 88's report, one rolled per round (never the same take twice in a row).
    // The list is the gun's sound: adding a take is a line here, and a gun with no takes is silent.
    report_clips: [
        "sfx/explosion/88_cannon_1.ogg",
        "sfx/explosion/88_cannon_2.ogg",
        "sfx/explosion/88_cannon_3.ogg",
        "sfx/explosion/88_cannon_4.ogg",
        "sfx/explosion/88_cannon_5.ogg",
    ],
    // The muzzle emission, view only (`src/guns/muzzle.rs`). No measured flash, smoke or light of
    // this gun has been read: every value is ASSUMED, the provisional presentation this gun's shots
    // already drew, kept for the owner's eye review and calibration.
    muzzle: (
        core: (
            sprite: (Starburst, Tuned("ASSUMED: provisional radial starburst read")),
            diameter_m: ((3.5, 4.6), Tuned("ASSUMED: provisional core flash diameter")),
            standoff_m: (1.0, Tuned("ASSUMED: provisional core centre down the bore")),
            lifetime_s: (0.026, Tuned("ASSUMED: provisional one-to-two-frame flash")),
            end_scale: (0.85, Tuned("ASSUMED: provisional collapse, born at its largest")),
        ),
        flames: (
            count: (2, Tuned("ASSUMED: provisional crossed flame planes")),
            length_m: ((4.3, 6.4), Tuned("ASSUMED: provisional flame length")),
            width_ratio: (0.55, Tuned("ASSUMED: provisional flame width over length")),
            lifetime_s: (0.045, Tuned("ASSUMED: provisional flame life, outliving the core")),
            end_scale: (0.9, Tuned("ASSUMED: provisional flame collapse")),
        ),
        fireball: (Some((
            diameter_m: ((8.0, 9.5), Tuned("ASSUMED: provisional fireball quad diameter")),
            growth: (1.12, Tuned("ASSUMED: provisional fireball expansion over its life")),
            standoff_m: (1.8, Tuned("ASSUMED: provisional fireball centre down the bore")),
            lifetime_s: (0.2, Tuned("ASSUMED: provisional fireball sheet playback window")),
        )), Tuned("ASSUMED: the gun's propellant gas burns as a visible fireball")),
        glow: (Some((
            scale: (1.5, Tuned("ASSUMED: provisional fill glow over the core diameter")),
            lifetime_s: (0.075, Tuned("ASSUMED: provisional fill glow life")),
            end_scale: (0.9, Tuned("ASSUMED: provisional fill glow collapse")),
        )), Tuned("ASSUMED: a fill glow bridges the flash and the smoke")),
        smoke: (Some((
            every_rounds: (1, Tuned("ASSUMED: every shot leaves a gas puff")),
            lifetime_s: (1.5, Tuned("ASSUMED: provisional muzzle smoke life")),
            diameter_m: ((2.2, 4.2), Tuned("ASSUMED: provisional smoke birth and end diameters")),
            standoff_m: (1.6, Tuned("ASSUMED: provisional smoke birth down the bore")),
            rise_mps: (0.55, Tuned("ASSUMED: provisional smoke rise")),
            push_mps: (1.3, Tuned("ASSUMED: provisional muzzle-gas push down the bore")),
            opacity: (0.92, Tuned("ASSUMED: provisional smoke opacity")),
        )), Tuned("ASSUMED: the propellant leaves visible smoke")),
        light: (
            peak_lm: (8.0e6, Tuned("ASSUMED: provisional muzzle light peak")),
            range_m: (35.0, Tuned("ASSUMED: provisional muzzle light range")),
            lifetime_s: (0.055, Tuned("ASSUMED: provisional flash-and-out light envelope")),
            radius_m: (0.4, Tuned("ASSUMED: provisional emitter radius")),
            standoff_m: (1.2, Tuned("ASSUMED: provisional light centre down the bore")),
            colour_srgb: ((1.0, 0.72, 0.42), Tuned("ASSUMED: provisional warm flash colour")),
            tracer_gain: (1.0, Tuned("ASSUMED: a tracer adds nothing visible to this flash")),
        ),
        ground_blast: (Some((
            reach_m: (2.5, Tuned("ASSUMED: provisional muzzle height the gas still lifts ground from")),
            puffs: ((5, 8), Tuned("ASSUMED: provisional puffs on fully erodible ground")),
            birth_diameter_m: (1.8, Tuned("ASSUMED: provisional dust puff birth diameter")),
            end_diameter_m: ((3.75, 5.0), Tuned("ASSUMED: provisional dust puff end diameter")),
            spread_m: ((0.4, 3.0), Tuned("ASSUMED: provisional birth offset from under the muzzle")),
            push_mps: ((1.8, 4.0), Tuned("ASSUMED: provisional outward dust drift")),
            rise_mps: (0.35, Tuned("ASSUMED: provisional dust lift, hugging the ground")),
            bore_bias: (0.65, Tuned("ASSUMED: provisional pull of each puff onto the bore azimuth")),
            lifetime_s: ((2.0, 2.5), Tuned("ASSUMED: provisional dust cloud life")),
            opacity: (0.5, Tuned("ASSUMED: provisional dust opacity")),
        )), Tuned("ASSUMED: the gun's gas lifts loose ground under a low barrel")),
    ),
)
