        ),
        // Crew. A WITNESS, not matter: a crew station neither stops a shell nor shadows a
        // fragment, so it has no resistance to state. What reduces its HP pool is the round's
        // crew line rate along the chord the shell's disc cut through it, and each spall
        // direction's strength entering it.
        "Flesh": Witness,
        // Dry timber: a construction's planks and plates. A living trunk uses its species'
        // green-wood row below. No penetration data: the
        // factor is the wood's crushing strength along the grain over the reference steel's flow
        // strength, scaled to the reference's 1000 — a strength ratio, the same reading the steels'
        // DERIVED rows note, not a measured equivalence.
        "Wood": Hard(
            resistance: Effective((40.0, StandIn("Stand-in for porous timber penetration from its own density and strength: no penetration data; spruce/pine crushing
                strength along the grain ~40 MPa (birch ~55) over the reference flow strength
                ~1 GPa, × 1000; the conifers' value, the forest's wood"))),
            visual: "dark_planks",
            feedback: (
                exposed_linear_rgb: ((0.32, 0.18, 0.08), Taste("material contact and fracture effects: ASSUMED: provisional exposed-surface and powder read; no measured optical response read for this substance")),
                powder_linear_rgb: ((0.34, 0.22, 0.12), Taste("material contact and fracture effects: ASSUMED: provisional exposed-surface and powder read; no measured optical response read for this substance")),
                metallic: (0.0, Taste("material contact and fracture effects: ASSUMED: provisional exposed-surface and powder read; no measured optical response read for this substance")),
                roughness_gain: (2.25, Taste("material contact and fracture effects: ASSUMED: provisional exposed-surface and powder read; no measured optical response read for this substance")),
                sparks: (false, Taste("material contact and fracture effects: ASSUMED: provisional contact-spark emission for this substance")),
            ),
            debris_half_angle_deg: (26.2, Unknown("no measured debris extent; RHA's value")),
            friction: Some((0.5, Unknown("ASSUMED, no source read: one side's value (wood on brick
                0.6, CLAIMED: read only in a search summary of RoyMech's 'Coefficients of
                Friction', 2026-10-31; the pair rule gives √(0.5 × 0.65) ≈ 0.57, DERIVED)"))),
            facts: None,
            bulk: Some((
                density: (448.0, Derived("red spruce specific gravity 0.40 at 12 % moisture (oven-dry
                    mass over volume at 12 %; USDA FPL Wood Handbook, FPL-GTR-190, 2010, Table 5-3a,
                    read in a third-party copy of the chapter) × 1000 kg/m³ × 1.12 for the moisture
                    mass")),
                tensile: Some((2.4e6, Measured("CLAIMED, not read: red spruce's tension
                    perpendicular to grain at 12 % moisture, about 2.4 MPa (USDA FPL Wood Handbook,
                    FPL-GTR-190, 2010, Table 5-3a, recalled; the spruces span about 2.4–2.6 MPa
                    there). A seam between two chunks of one timber is the timber parting across
                    its grain, the weaker way, and a bond between timbers is no stronger than the
                    wood"))),
                fracture_energy: Some((370.0, Derived("G = K_IC² / E_T: MEASURED red spruce
                    mode I toughness, TL system, 0.42 MPa·√m (USDA FPL Wood Handbook,
                    FPL-GTR-190, 2010, Table 5-10, read in a third-party copy of the chapter;
                    mode I range 220–550 kPa·√m), over red spruce's tangential modulus,
                    E_T ≈ 0.043 × E_L with E_L ≈
                    11.1 GPa at 12 % moisture (CLAIMED, not read: Wood Handbook Tables 5-1 and
                    5-3a, recalled), 0.48 GPa: 370 J/m²"))),
                // Blast inputs: the crush law reads this block. ASSUMED European-spruce
                // analogue for the scalar forest timber; the existing density and seam data
                // retain their own sources. Grain and moisture are not resolved by this row.
                blast: Some((
                    compressive_strength: Some((5.6e6, Measured("spruce, tangential compression,
                        quasi-static mean yield stress 5.60 MPa; Zulkifli, Kusumaningrum and Rahmi,
                        Experimental Study and Numerical Model of Spruce and Teak Wood Strength
                        Properties Under Compressive High Strain Rate Loading, J. Eng. Technol.
                        Sci. 53(1), 210103 (2021), Table 3, read primary (specimen moisture 8-10%).
                        https://journals.itb.ac.id/index.php/jets/article/download/13345/pdf_111/44406;
                        doi:10.5614/j.eng.technol.sci.2021.53.1.3"))),
                    compressive_dif: Some((5.960714285714286, StandIn("Stand-in for loading-rate-dependent compressive strength: MEASURED tangential yield
                        stress 33.38 MPa at 2400 /s (specimen ST-52, Zulkifli et al. 2021,
                        Table 7; tangential tests span 591-2530 /s) divided by the same study's
                        quasi-static mean 5.60 MPa (Table 3).
                        The current law applies this reference-rate ratio at every loading rate; read
                        primary at the compressive_strength URL. ASSUMED spruce analogue"))),
                    solid_density: Some((1500.0, Derived("1.5 g/cm³ x 1000 = 1500 kg/m³, the
