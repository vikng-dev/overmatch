// The ground-type table (`src/ground_types.rs`): physical traction and motion resistance,
// and cosmetic prints and dust. Each terrain pack names its type (`src/terrain_blend.rs`).
//
//   softness_mm_per_kpa  print depth per unit of the tank's ground pressure, mm per kPa
//   depth_cap_mm         the deepest print this ground takes, mm
//   darkening            the share of albedo a print takes away, 0..1
//   roughness_gain       roughness multiplier under a sole; below 1 reads wet
//   grip                 effective track capacity / normal load, labelled
//   rolling_resistance   total motion resistance at grip.ron rolling_reference_kpa, labelled
//   dust.erodibility     the share of a gun's muzzle dust cloud this ground lifts, 0..1
//   dust.colour_srgb     the lifted soil's albedo, sRGB, each channel 0..1
//   strike.lifted        the share of a round's strike read this ground throws, 0..1, labelled
//   strike.sparks        whether a strike on this ground throws contact sparks, labelled
//
// Every print value is ASSUMED: ordered by the Bekker fits in the ground-stamping note's §2, dirt
// and gravel raised so a print reads at 10-30 m, then tuned by eye in play (`track_prints::tuning`).
// terrain_solver_friction is the explicit Avian solid-body stand-in, not track grip.
// Track laws and row derivations: .agents/docs/design/track-model/architecture.md section 5a.
// Each strike value carries its own label and note. Every erodibility is ASSUMED, no source read: ordered by hand, loose dry dirt
// and sand giving the whole cloud, gravel most of it, wet mud and intact paving little. Each
// pack's dust colour is DERIVED: the mean of the pack's shipped full-resolution albedo slice
// (`coast_sand_rocks_02_diff.ktx2`, `blend_diff.ktx2`), MEASURED; concrete names no pack, and its
// light grey is ASSUMED.
(
    terrain_solver_friction: (0.5, StandIn("Avian solid-body contacts expose no soil contact footprint; retained base-terrain sliding coefficient pending an area-aware solid-body/soil contact law; the track reads each row's effective grip")),
    types: {
        "concrete": (
            grip: (0.600, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED sqrt(0.6*0.6) = 0.600; shipped proxies at 89.5 kPa, no representative ground/track pull measured; settle with a track-pull and holding-limit test on this ground")),
            print: (
                softness_mm_per_kpa: 0.0,
                depth_cap_mm: 0.0,
                darkening: 0.05,
                roughness_gain: 1.0,
            ),
            rolling_resistance: (0.040000000, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED 0.04 + (0.04 - 0.04)*100/89.5 = 0.040000000 at Unit 100 kPa, from the CLAIMED 0.04 seed at 89.5 kPa; no coast-down measured on representative ground; settle with pressure-varied coast-down tests")),
            dust: (
                erodibility: 0.1,
                colour_srgb: (0.62, 0.61, 0.58),
            ),
            strike: (
                lifted: (0.1, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: intact paving gives up little")),
                sparks: (true, Taste("impact effects: ASSUMED: hard aggregate throws contact sparks under a strike")),
            ),
        ),
        "dirt": (
            grip: (0.418, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED tan(20 deg) + 4830/89500, rounded to .418; shipped proxies at 89.5 kPa, no representative ground/track pull measured; settle with a track-pull and holding-limit test on this ground")),
            print: (
                softness_mm_per_kpa: 0.5,
                depth_cap_mm: 70.0,
                darkening: 0.2,
                roughness_gain: 0.9,
            ),
            rolling_resistance: (0.062346369, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED 0.04 + (0.06 - 0.04)*100/89.5 = 0.062346369 at Unit 100 kPa, from the CLAIMED 0.06 seed at 89.5 kPa; no coast-down measured on representative ground; settle with pressure-varied coast-down tests")),
            dust: (
                erodibility: 1.0,
                colour_srgb: (0.48, 0.39, 0.31),
            ),
            strike: (
                lifted: (1.0, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: loose dry soil gives the whole read")),
                sparks: (false, Taste("impact effects: ASSUMED: soft soil holds no stone to spark")),
            ),
        ),
        "gravel": (
            grip: (0.712, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED tan(35 deg) + 1040/89500, rounded to .712; shipped proxies at 89.5 kPa, no representative ground/track pull measured; settle with a track-pull and holding-limit test on this ground")),
            print: (
                softness_mm_per_kpa: 0.45,
                depth_cap_mm: 60.0,
                darkening: 0.2,
                roughness_gain: 1.0,
            ),
            rolling_resistance: (0.051173184, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED 0.04 + (0.05 - 0.04)*100/89.5 = 0.051173184 at Unit 100 kPa, from the CLAIMED 0.05 seed at 89.5 kPa; no coast-down measured on representative ground; settle with pressure-varied coast-down tests")),
            dust: (
                erodibility: 0.8,
                colour_srgb: (0.3, 0.28, 0.19),
            ),
            strike: (
                lifted: (0.8, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: a stony ground gives most of the read")),
                sparks: (true, Taste("impact effects: ASSUMED: the stones in this ground throw contact sparks under a strike")),
            ),
        ),
        "mud": (
            grip: (0.277, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED tan(13 deg) + 4140/89500, rounded to .277; shipped proxies at 89.5 kPa, no representative ground/track pull measured; settle with a track-pull and holding-limit test on this ground")),
            print: (
                softness_mm_per_kpa: 1.6,
                depth_cap_mm: 150.0,
                darkening: 0.3,
                roughness_gain: 0.6,
            ),
            rolling_resistance: (0.162905028, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED 0.04 + (0.15 - 0.04)*100/89.5 = 0.162905028 at Unit 100 kPa, from the CLAIMED 0.15 seed at 89.5 kPa; no coast-down measured on representative ground; settle with pressure-varied coast-down tests")),
            dust: (
                erodibility: 0.3,
                colour_srgb: (0.25, 0.23, 0.22),
            ),
            strike: (
                lifted: (0.3, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: wet cohesive ground holds together and gives little")),
                sparks: (false, Taste("impact effects: ASSUMED: wet cohesive ground holds no stone to spark")),
            ),
        ),
        "sand": (
            grip: (0.543, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED tan(28 deg) + 1040/89500, rounded to .543; shipped proxies at 89.5 kPa, no representative ground/track pull measured; settle with a track-pull and holding-limit test on this ground")),
            print: (
                softness_mm_per_kpa: 0.8,
                depth_cap_mm: 120.0,
                darkening: 0.12,
                roughness_gain: 0.9,
            ),
            rolling_resistance: (0.129385475, Unknown(".agents/docs/design/track-model/architecture.md section 5a: DERIVED 0.04 + (0.12 - 0.04)*100/89.5 = 0.129385475 at Unit 100 kPa, from the CLAIMED 0.12 seed at 89.5 kPa; no coast-down measured on representative ground; settle with pressure-varied coast-down tests")),
            dust: (
                erodibility: 1.0,
                colour_srgb: (0.27, 0.24, 0.19),
            ),
            strike: (
                lifted: (1.0, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: loose dry sand gives the whole read")),
                sparks: (false, Taste("impact effects: ASSUMED: fine sand holds no stone to spark")),
            ),
        ),
    },
)
