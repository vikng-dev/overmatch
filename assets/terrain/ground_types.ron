// The ground-type table (`src/ground_types.rs`): physical traction and motion resistance,
// and cosmetic prints and dust. Each terrain pack names its type (`src/terrain_blend.rs`).
//
//   softness_mm_per_kpa  print depth per unit of the tank's ground pressure, mm per kPa
//   depth_cap_mm         the deepest print this ground takes, mm
//   darkening            the share of albedo a print takes away, 0..1
//   roughness_gain       roughness multiplier under a sole; below 1 reads wet
//   friction             the friction coefficient the ground brings to a contact, one side's
//   traction             rigid friction or labelled soil cohesion, friction angle and shear distance
//   rolling_resistance   the ground's motion resistance coefficient on a moving track, labelled
//   dust.erodibility     the share of a gun's muzzle dust cloud this ground lifts, 0..1
//   dust.colour_srgb     the lifted soil's albedo, sRGB, each channel 0..1
//   strike.lifted        the share of a round's strike read this ground throws, 0..1, labelled
//   strike.sparks        whether a strike on this ground throws contact sparks, labelled
//
// Every print value is ASSUMED: ordered by the Bekker fits in the ground-stamping note's §2, dirt
// and gravel raised so a print reads at 10-30 m, then tuned by eye in play (`track_prints::tuning`).
// The module doc of `src/ground_types.rs` carries the provenance. Every friction is ASSUMED, no
// source read: gravel, the terrain collider's ground, at Avian's own default 0.5; the others
// ordered by hand, paving gripping best and mud least. Each rolling resistance carries its own
// label and note, as does each strike value. Every erodibility is ASSUMED, no source read: ordered by hand, loose dry dirt
// and sand giving the whole cloud, gravel most of it, wet mud and intact paving little. Each
// pack's dust colour is DERIVED: the mean of the pack's shipped full-resolution albedo slice
// (`coast_sand_rocks_02_diff.ktx2`, `blend_diff.ktx2`), MEASURED; concrete names no pack, and its
// light grey is ASSUMED.
(
    types: {
        "concrete": (
            traction: Rigid,
            print: (
                softness_mm_per_kpa: 0.0,
                depth_cap_mm: 0.0,
                darkening: 0.05,
                roughness_gain: 1.0,
            ),
            friction: 0.6,
            rolling_resistance: (0.04, Unknown("the ground-stamping note gives soil fits but no motion resistance; a tracked vehicle on intact paving is CLAIMED at 0.03-0.05 (recalled from Wong, Theory of Ground Vehicles, the tracked-vehicle motion resistance table, not read for this value); settle by reading that table or by a coast-down of a tracked vehicle on this ground")),
            dust: (
                erodibility: 0.1,
                colour_srgb: (0.62, 0.61, 0.58),
            ),
            strike: (
                lifted: (0.1, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: intact paving gives up little")),
                sparks: (true, Taste("impact effects: ASSUMED: hard aggregate throws contact sparks under a strike")),
            ),
        ),
        "dirt": (
            traction: Soil(
                cohesion_pa: (4830.0, Unknown("sandy loam, moisture 11%: CLAIMED specimen fit from NASA tire-ground overview Table 1 reproduced in track-prints-ground-stamping section 2; no map soil specimen measured; settle with a direct shear test")),
                friction_angle_deg: (20.0, Unknown("sandy loam, moisture 11%: CLAIMED specimen proxy from ground-stamping section 2; gravel angle is provisional, no gravel fit supplied; settle with a direct shear test")),
                shear_deformation_m: (0.01, Unknown("sandy loam, moisture 11%: CLAIMED characteristic shear distance, clay 6 mm, firm soil 10 mm, loose sand 25 mm; settle with a shear-displacement curve on the map soil")),
            ),
            print: (
                softness_mm_per_kpa: 0.5,
                depth_cap_mm: 70.0,
                darkening: 0.2,
                roughness_gain: 0.9,
            ),
            friction: 0.5,
            rolling_resistance: (0.06, Unknown("the ground-stamping note gives soil fits but no motion resistance; a tracked vehicle on firm dry soil is CLAIMED at 0.05-0.08 (recalled from Wong, Theory of Ground Vehicles, the tracked-vehicle motion resistance table, not read for this value); settle by reading that table or by a coast-down of a tracked vehicle on this ground")),
            dust: (
                erodibility: 1.0,
                colour_srgb: (0.48, 0.39, 0.31),
            ),
            strike: (
                lifted: (1.0, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: loose dry soil gives the whole read")),
                sparks: (false, Taste("impact effects: ASSUMED: soft soil holds no stone to spark")),
            ),
        ),
        "gravel": (
            traction: Soil(
                cohesion_pa: (1040.0, Unknown("compacted granular ground; angle provisional, dry-sand cohesion proxy: CLAIMED specimen fit from NASA tire-ground overview Table 1 reproduced in track-prints-ground-stamping section 2; no map soil specimen measured; settle with a direct shear test")),
                friction_angle_deg: (35.0, Unknown("compacted granular ground; angle provisional, dry-sand cohesion proxy: CLAIMED specimen proxy from ground-stamping section 2; gravel angle is provisional, no gravel fit supplied; settle with a direct shear test")),
                shear_deformation_m: (0.01, Unknown("compacted granular ground; angle provisional, dry-sand cohesion proxy: CLAIMED characteristic shear distance, clay 6 mm, firm soil 10 mm, loose sand 25 mm; settle with a shear-displacement curve on the map soil")),
            ),
            print: (
                softness_mm_per_kpa: 0.45,
                depth_cap_mm: 60.0,
                darkening: 0.2,
                roughness_gain: 1.0,
            ),
            friction: 0.5,
            rolling_resistance: (0.05, Unknown("the ground-stamping note gives soil fits but no motion resistance; a tracked vehicle on a compacted gravel or dirt road is CLAIMED at 0.04-0.07 (recalled from Wong, Theory of Ground Vehicles, the tracked-vehicle motion resistance table, not read for this value); settle by reading that table or by a coast-down of a tracked vehicle on this ground")),
            dust: (
                erodibility: 0.8,
                colour_srgb: (0.3, 0.28, 0.19),
            ),
            strike: (
                lifted: (0.8, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: a stony ground gives most of the read")),
                sparks: (true, Taste("impact effects: ASSUMED: the stones in this ground throw contact sparks under a strike")),
            ),
        ),
        "mud": (
            traction: Soil(
                cohesion_pa: (4140.0, Unknown("clayey soil, moisture 38%: CLAIMED specimen fit from NASA tire-ground overview Table 1 reproduced in track-prints-ground-stamping section 2; no map soil specimen measured; settle with a direct shear test")),
                friction_angle_deg: (13.0, Unknown("clayey soil, moisture 38%: CLAIMED specimen proxy from ground-stamping section 2; gravel angle is provisional, no gravel fit supplied; settle with a direct shear test")),
                shear_deformation_m: (0.006, Unknown("clayey soil, moisture 38%: CLAIMED characteristic shear distance, clay 6 mm, firm soil 10 mm, loose sand 25 mm; settle with a shear-displacement curve on the map soil")),
            ),
            print: (
                softness_mm_per_kpa: 1.6,
                depth_cap_mm: 150.0,
                darkening: 0.3,
                roughness_gain: 0.6,
            ),
            friction: 0.3,
            rolling_resistance: (0.15, Unknown("the ground-stamping note gives soil fits but no motion resistance; a tracked vehicle on wet cohesive soil is CLAIMED at 0.12-0.20 and more (recalled from Wong, Theory of Ground Vehicles, the tracked-vehicle motion resistance table, not read for this value); settle by reading that table or by a coast-down of a tracked vehicle on this ground")),
            dust: (
                erodibility: 0.3,
                colour_srgb: (0.25, 0.23, 0.22),
            ),
            strike: (
                lifted: (0.3, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: wet cohesive ground holds together and gives little")),
                sparks: (false, Taste("impact effects: ASSUMED: wet cohesive ground holds no stone to spark")),
            ),
        ),
        "sand": (
            traction: Soil(
                cohesion_pa: (1040.0, Unknown("dry loose sand: CLAIMED specimen fit from NASA tire-ground overview Table 1 reproduced in track-prints-ground-stamping section 2; no map soil specimen measured; settle with a direct shear test")),
                friction_angle_deg: (28.0, Unknown("dry loose sand: CLAIMED specimen proxy from ground-stamping section 2; gravel angle is provisional, no gravel fit supplied; settle with a direct shear test")),
                shear_deformation_m: (0.025, Unknown("dry loose sand: CLAIMED characteristic shear distance, clay 6 mm, firm soil 10 mm, loose sand 25 mm; settle with a shear-displacement curve on the map soil")),
            ),
            print: (
                softness_mm_per_kpa: 0.8,
                depth_cap_mm: 120.0,
                darkening: 0.12,
                roughness_gain: 0.9,
            ),
            friction: 0.4,
            rolling_resistance: (0.12, Unknown("the ground-stamping note gives soil fits but no motion resistance; a tracked vehicle on loose dry sand is CLAIMED at 0.10-0.15 (recalled from Wong, Theory of Ground Vehicles, the tracked-vehicle motion resistance table, not read for this value); settle by reading that table or by a coast-down of a tracked vehicle on this ground")),
            dust: (
                erodibility: 1.0,
                colour_srgb: (0.27, 0.24, 0.19),
            ),
            strike: (
                lifted: (1.0, Taste("impact effects: ASSUMED share of a round's strike read this ground throws: loose dry sand gives the whole read")),
                sparks: (false, Taste("impact effects: ASSUMED: fine sand holds no stone to spark")),
            ),
        ),
    },
)
