// The game's prototype library for this map: what each prototype id the map's `level.json`
// references resolves to. The level file's own `prototypes` block is the AUTHOR'S export record
// (which glb, whether it shipped) and is rewritten on every export, so the game's reading of an id
// lives here, beside it, keyed by the same ids. Metres at instance scale 1; the instance's own
// uniform scale multiplies everything.
//
// `Building(min, max, substance, surface)`: an axis-aligned box in the prototype's local frame
// around the instance origin; a `min.y` below zero is a skirt that sinks into the surface. A
// building is also a `TerrainMap` block (the belts sense it). `substance` is the `materials.ron` row
// whose friction its collider carries. `surface` names each face's palette lane (+X, -X, +Z, -Z,
// +Y, -Y) and the cube edge, `X` or `Z`, its top's tangent runs along.
// `Tree(asset)`: a tree of the damage model, `assets/trees/<asset>/`; one static body with a
// collider per segment, never a block.
// `Structure(asset)`: a building of the destruction model, `assets/buildings/<asset>/`, baked by
// the asset tools; one static body with a collider per element (pier, sill, lintel, gable, wall
// plate, roof plane), never a block. `house_proxy` was `Building(min: (-2.0, -0.5, -3.0), max:
// (2.0, 2.5, 3.0))`, and `house_1` keeps that box's footprint and skirt.
{
    "house_proxy": Structure(asset: "house_1"),
    "church_proxy": Building(min: (-15.0, -18.5, -7.5), max: (15.0, 18.5, 7.5), substance: "Brick", surface: (faces: (Primary, Primary, Primary, Primary, Secondary, Primary), top_tangent: Z)),
    "fir_tree_01_a_LOD2": Tree(asset: "fir_1"),
    "fir_tree_01_b_LOD2": Tree(asset: "fir_1"),
    "fir_tree_01_c_LOD2": Tree(asset: "fir_1"),
}
