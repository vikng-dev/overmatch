// The 8.8 cm Pzgr. 39 bursting as the ring: the Pzgr. 39's body with its burst core. DERIVED at
// load from the data below and the body's GunSteel density: a cavity of 36.4 cm³ and 36.3 mm
// length; a wall of 1.440 kg and a nose of 8.370 kg; v_s 541.5 m/s (the wall driven) and 211.1 kJ
// of driven-mass energy. No source gives the nose's mass: DERIVED, provisional.
// The file's fields are `src/rounds.rs`'s module doc.
(
    name: ("8.8 cm Pzgr. 39 ring", Tuned("the owner's comparison (brief 4b): the 8.8 cm Pzgr. 39
        bursting as the ring")),
    round_type: ("APCBC", Measured("the Pzgr. 39 is the 8.8 cm KwK 36's APCBC round:
        en.wikipedia.org/wiki/8.8_cm_KwK_36, ammunition table")),
    core: ("GunSteel", Tuned("the Pzgr. 39's fixture body steel")),
    mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5
        (1993), p.17")),
    caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
    wound: (30.0, Tuned("the Pzgr. 39's main-gun rate, kept by the nose piece past the burst: the
        30 HP crew pool is emptied at ~10 cm of chord (3 / 0.10)")),
    burst: Some((
        core_substance: ("88mm_burst_core", Measured("the round's burst core:
            tiger-ammo-history.md")),
        option: (Ring, Tuned("the owner's comparison (brief 4b): the wall becomes a band, the nose
            piece flies on")),
        arming_spend: (35.0, Measured("the reference-mm the round spends in one body to arm the
            fuze, read as the 35 mm of plate of about 115 kg per square mm the Bd.Z. 5127 arms on,
            perforated at normal impact, values for 1000 m (L.Dv. 487, March 1943, page 487_21):
            burst-delay-history.md")),
        delay: (0.0015, Derived("the midpoint of the 1-2 ms within which the Bd.Z. 5127 bursts
            after the round's deceleration ends (L.Dv. 487, March 1943, page 487_21). The 5127 is
            the Pzgr. 39/1's and 39/43's fuze; no time is found for this round's own Bd.Z. 5103:
            burst-delay-history.md")),
        core_mass: (0.060, Measured("range 0.059-0.064 kg: tiger-ammo-history.md")),
        base_mass: (0.33, Measured("the trigger and trace element at the base, range 0.319-0.333
            kg: tiger-ammo-history.md")),
        cavity_diameter: (0.0357, Tuned("provisional: the measured core diameter of the round's
            predecessor (tiger-ammo-history.md); no source gives this round's")),
    )),
)
