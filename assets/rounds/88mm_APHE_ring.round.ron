// The 8.8 cm Pzgr. 39 with its burst core, bursting as every burst round does, as the ring: the
// Pzgr. 39's body with its burst core. DERIVED at load from the data below and the body's GunSteel
// density: a cavity of 68.5 cm³ and 70.0 mm length; a wall of 2.786 kg and a nose of 6.971 kg;
// v_s 534.4 m/s (the wall driven) and 397.7 kJ of driven-mass energy. No source gives the nose's
// mass: DERIVED, provisional.
// The file's fields are `src/rounds.rs`'s module doc.
(
    name: ("8.8 cm Pzgr. 39 ring", Tuned("the 8.8 cm Pzgr. 39 bursting as the ring; the suffix sets
        it apart from the solid fixture round of the same designation, 88mm_AP")),
    round_type: ("APCBC", Measured("CITED TM 9-1985-3 pp.447-448: the Pzgr. 39 listed for the
        Kw.K. 36 as armour-piercing, capped, ballistic-capped, with a filler")),
    core: ("GunSteel", Tuned("the Pzgr. 39's fixture body steel")),
    mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5
        (1993), p.17")),
    caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
    wound: (30.0, Tuned("the Pzgr. 39's main-gun rate, kept by the nose piece past the burst: the
        30 HP crew pool is emptied at ~10 cm of chord (3 / 0.10)")),
    fuze: Some((
        position: (Base, Measured("CITED TM53 p.448: base fuze Bd.Z. 5103 or 5103/1")),
        trigger: (SpendExit(arming_spend: 35.0), Tuned("UNVERIFIED, CLAIMED: the reference-mm the
            round spends in one body to arm the fuze, read as the 35 mm of plate of about 115 kg
            per square mm the Bd.Z. 5127 arms on, perforated at normal impact, values for 1000 m
            (L.Dv. 487, March 1943, page 487_21). L.Dv. 487 could not be located again, and no
            other source read gives a plate thickness for the 5103 or the 5127")),
        modes: [
            (name: ("delay", Tuned("the fuze's one mode; a name the HUD would draw")),
                delay_s: (0.0015, Derived("UNVERIFIED, CLAIMED: the midpoint of the 1-2 ms within
                which the Bd.Z. 5127 bursts after the round's deceleration ends (L.Dv. 487, March
                1943, page 487_21; not located again). The 5127 is the Pzgr. 39/1's and 39/43's
                fuze; no time is found for this round's own Bd.Z. 5103"))),
        ],
        default_mode: ("delay", Tuned("the fuze's one mode")),
    )),
    burst: Some((
        core_substance: ("88mm_burst_core", Tuned("the burst core's substance in materials.ron,
            cyclonite/wax 90/10 by TM 9-1985-3 p.448")),
        core_mass: (0.113, Derived("CITED TM 9-1985-3 p.448: 1/4 lb of cyclonite/wax 90/10 in
            blocks, the one entry that names the Kw.K. 36; 0.25 lb x 0.4536 kg/lb = 0.1134 kg,
            rounded to 0.113. The 0.060 kg of TTT30 and TM 9-1985-3 p.438 is the Flak 41's
            Pzgr. Patr. 39, a 'small cavity' round, not this gun's")),
        base_mass: (0.33, Tuned("UNVERIFIED: HEA12 p.19 gives 11.5 oz = 0.326 kg for the Bd.Z. 5127
            with its tracer, the Pzgr. 39/1 and 39/43's fuze. This round carries the Bd.Z. 5103 or
            5103/1 (TM 9-1985-3 p.448), whose mass no source read gives; the 5127's stands in")),
        cavity_diameter: (0.0353, Derived("No source gives this round's cavity. The cylinder that
            holds the filler: V = 0.113 kg / 1650 kg/m3 = 68.5 cm3 (the mass CITED above; the
            density the burst core substance carries in materials.ron, DERIVED there and ASSUMED to
            hold for cyclonite/wax 90/10), over an ASSUMED cavity length of 70 mm (no source gives
            it; a slender base cavity, longer than it is wide), d = sqrt(4 V / (pi L)) = 35.29 mm, authored
            as 35.3 mm. The burst law re-derives the length from d, the mass and the density: 70.0 mm")),
    )),
)
