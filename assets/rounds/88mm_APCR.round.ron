// The Pzgr. 40. It flies as its whole body and meets the plate as its core (`penetrator` below):
// at the muzzle the core reads about 180 reference-mm against the Pzgr. 39's about 115 (DERIVED
// from the force law with the shipped RHA facts; read as its whole body it would be about 112), a
// ratio of 1.57 against the record's about 1.4 (Jentz & Doyle: more at the muzzle, less behind the
// plate), and its cone's hole term is (35.7 / 88)² = 0.165 (DERIVED). Still provisional: the
// core's nose is the round's, a labelled fixture, and the rigid rule reads no fact of the core.
// The file's fields are `src/rounds.rs`'s module doc.
(
    name: ("8.8 cm Pzgr. 40", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle, Tiger I
        Heavy Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
    round_type: ("APCR", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle, Tiger I Heavy
        Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
    core: ("TungstenCarbide", Measured("the round's 1.93 kg core is tungsten carbide: US Army TM
        9-1985-3, German Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953,
        pp.439-440. The rigid regime reads no core fact")),
    mass: (7.3, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5 (1993),
        p.17")),
    caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
    wound: (30.0, Tuned("the Pzgr. 39's main-gun rate: the 30 HP crew pool is emptied at ~10 cm of
        chord (3 / 0.10)")),
    penetrator: Some((
        mass: (1.93, Measured("the tungsten-carbide core, 4.25 lb: US Army TM 9-1985-3, German
            Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953, pp.439-440; the
            conversion to kg is DERIVED")),
        caliber: (0.0357, Measured("the core's diameter, 1.406 in: US Army TM 9-1985-3, German
            Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953, pp.439-440; the
            conversion to m is DERIVED")),
    )),
)
