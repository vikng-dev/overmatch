// Subject: the game's damage model and its view, game state only.
// The Pzgr. 40. It flies as its whole body and meets the plate as its core (`penetrator` below):
// at the muzzle the core reads about 180 reference-mm against the Pzgr. 39's about 115 (DERIVED
// from the force law with the shipped RHA facts; read as its whole body it would be about 112), a
// ratio of 1.57 against the record's about 1.4 (Jentz & Doyle: more at the muzzle, less behind the
// plate). Its cone is a share of the energy the core loses at a plate, so it is weaker than the
// Pzgr. 39's: the lighter core loses about a fifth of what that round loses through the same
// plate (s12 against s1, MEASURED from the records). Still provisional: the core's nose is the
// round's, a labelled fixture, and the rigid rule reads no fact of the core.
// The file's fields are `src/rounds.rs`'s module doc.
(
    nose: None,
    burst: None,
    fuze: None,
    name: ("8.8 cm Pzgr. 40", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle, Tiger I
        Heavy Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
    round_type: ("APCR", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle, Tiger I Heavy
        Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
    core: ("TungstenCarbide", Measured("the round's 1.93 kg core is tungsten carbide: US Army TM
        9-1985-3, German Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953,
        pp.439-440. The rigid regime reads no core fact")),
    mass: (7.3, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5 (1993),
        p.17")),
    caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
    wound: (30.0, Unit("the Pzgr. 39's main-gun rate: the 30 HP crew pool is emptied at ~10 cm of
        chord (3 / 0.10)")),
    penetrator: Some((
        mass: (1.93, Measured("the tungsten-carbide core, 4.25 lb: US Army TM 9-1985-3, German
            Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953, pp.439-440; the
            conversion to kg is DERIVED")),
        caliber: (0.0357, Measured("the core's diameter, 1.406 in: US Army TM 9-1985-3, German
            Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953, pp.439-440; the
            conversion to m is DERIVED")),
    )),
    effects: (
        impact: (Layered, Taste("round impact effects: ASSUMED: provisional authored contact-read
            recipe; no emission measurement")),
        ember: (Some((
            radius_m: (0.09, Taste("round flight effects: ASSUMED: provisional presentation bead
                radius, preserved from the original effect")),
            base_offset_m: (0.35, Unknown("ASSUMED: base of the current shell view; replace from this round's certified visual geometry")),
            burn_s: (2.0, Unknown("ASSUMED: provisional tracer burn, no measured duration read")),
            fade_s: (0.4, Taste("round flight effects: ASSUMED: provisional burn-out tail")),
            emissive: ((10.0, 2.5, 0.5), Taste("round flight effects: ASSUMED: provisional
                red-orange linear HDR output")),
        )), Unknown("ASSUMED: retained provisional tracer signature; no measured emission data has been read for this round")),
        smoke: (Some((
            lifetime_s: (2.2, Taste("round flight effects: ASSUMED: provisional smoke dissolution
                time")),
            width_m: (0.35, Taste("round flight effects: ASSUMED: provisional smoke birth diameter")),
            growth_mps: (1.3, Taste("round flight effects: ASSUMED: provisional smoke expansion rate")),
            lateral_accel_mps2: (0.4, Taste("round flight effects: ASSUMED: provisional smoke shear
                coefficient")),
            rise_accel_mps2: (0.35, Taste("round flight effects: ASSUMED: provisional smoke rise
                coefficient")),
            start_m: (10.0, Taste("round flight effects: ASSUMED: muzzle cloud occupies the first
                travelled arc")),
            fade_m: (20.0, Taste("round flight effects: ASSUMED: smoke ribbon's birth taper beyond
                the muzzle cloud")),
        )), Unknown("ASSUMED: provisional smoke signature retained with this round's tracer")),
        body: (Some((model: ("shell/shell.glb", Unknown("ASSUMED: the one authored shell model, an
            88 mm full-calibre body; this round's own body is not modelled")))),
            Taste("round flight effects: a main-gun round is drawn as its body in flight")),
        streak: (None, Taste("round flight effects: a main-gun round's tracer is its ember; no belt
            streak")),
    ),

)
