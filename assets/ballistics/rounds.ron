// The round registry: every round a weapon can fire, keyed by the names a weapon's `rounds` list.
// Read by `src/rounds.rs`, embedded and parsed once, validated at parse; a round is bound to its
// mechanism at spawn from this data alone.
//
// A round states its display name (its historical designation, what a player reads; the key is
// never shown, and a round without a name does not load), its core material (a substance in
// `assets/materials/materials.ron` that carries material facts), its nose as geometry in calibres
// (the nose factor is DERIVED from it at load), its mass (kg), its calibre (m), its muzzle
// speed (m/s) and its crew line rate.
//
// `wound` = the crew line rate (ADR-0040): reference-mm of dose per metre of disc-mean chord the
// shell cuts through a crew box. Balance data, read by nothing in the hard walk. Scaled from the
// 30 HP crew pool (3 reference-mm, `ballistics::HP_PER_REFERENCE_MM`): a rate of `3 / L` empties
// the pool at a chord of `L` metres.
//
// PROVENANCE: every value is authored `(value, Kind("source or reason"))`, Kind one of Measured,
// Derived, Tuned, Resolution, Unknown (`src/provenance.rs`); a value without one does not load.
// "Q7" is the fixture-materials recommendation in
// `.agents/scratch/damage-cam-2026-10-08/research/hardness-anchor-free.md`, which collected no
// munition data: the rounds are labelled fixtures.
(
    rounds: {
        "88mm_AP": (
            name: ("8.8 cm Pzgr. 39", Measured("the 8.8 cm KwK 36's APCBC round, whose 10.2 kg
                and 773 m/s this entry carries; en.wikipedia.org/wiki/8.8_cm_KwK_36, ammunition
                table")),
            core: ("GunSteel", Tuned("fixture label: a quenched-and-tempered 4340-class alloy-steel
                body, the class Q7 recommends for the large round; GunSteel carries that class's
                facts. The rigid regime reads no core fact")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: a blunt ogive of 1 crh")),
            mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("a main-gun round empties the 30 HP crew pool at ~10 cm of chord
                (3 / 0.10): a clean pass through a station knocks it out, a graze of its edge
                leaves it reduced (crew-model decision 2026-10-17)")),
        ),
        "88mm_APCR": (
            name: ("8.8 cm Pzgr. 40", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle,
                Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
            core: ("GunSteel", Tuned("placeholder until a tungsten-carbide substance lands: the
                round's 1.93 kg core is tungsten carbide (TM 9-1985-3), which materials.ron does
                not carry. The rigid regime reads no core fact")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: the Pzgr. 39's blunt ogive of
                1 crh")),
            // Potency is provisional: the strength law reads mass, calibre and nose and has no
            // penetrator term yet (decision #4 in
            // .agents/scratch/damage-cam-2026-10-08/research/ap-aphe-2026-10-23/decision-2026-10-23.md,
            // the hole-size term from penetrator mass and calibre), so at the muzzle this round
            // reads about 112 reference-mm against the Pzgr. 39's about 115 (DERIVED from the
            // force law with the shipped RHA facts), the reverse of the record (Jentz & Doyle:
            // more at the muzzle, less behind the plate). Until that term lands, selecting it
            // buys muzzle speed alone.
            mass: (7.3, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (930.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("the Pzgr. 39's main-gun rate: the 30 HP crew pool is emptied at
                ~10 cm of chord (3 / 0.10)")),
        ),
        "7.9mm_AP": (
            name: ("7.92 mm S.m.K.", Measured("Spitzgeschoss mit Kern, the German 7.92 mm
                steel-cored armour-piercing bullet (panzerworld.com/german-ammunition-nomenclature;
                en.wikipedia.org/wiki/7.92x94mm_Patronen). The best-attested match: this entry's
                mass and speed are unsourced and not tied to it")),
            core: ("GunSteel", Tuned("fixture label: a quenched-and-tempered alloy-steel core,
                Q7's 'hardened' belt; GunSteel carries that class's facts. The rigid regime reads
                no core fact")),
            nose: (Cap(radius_calibres: 0.5), Tuned("labelled fixture value: round-nosed, a
                hemispherical cap")),
            mass: (0.0118, Unknown("no source recorded in the repo; settled by a cited munition
                table")),
            caliber: (0.0079, Unknown("rounded from the 7.92 mm nominal designation; whether the
                bore or the bullet diameter is meant is not recorded")),
            muzzle_speed: (755.0, Unknown("no source recorded in the repo; settled by a cited
                firing table")),
            wound: (10.0, Tuned("a rifle-calibre bullet empties the 30 HP crew pool at ~30 cm of
                chord (3 / 0.30): one pass through a station leaves it reduced, two knock it out
                (crew-model decision 2026-10-17)")),
        ),
    },
)
