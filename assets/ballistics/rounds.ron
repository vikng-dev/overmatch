// The round registry: every round a weapon can fire, keyed by the names a weapon's `rounds` list.
// Read by `src/rounds.rs`, embedded and parsed once, validated at parse; a round is bound to its
// mechanism at spawn from this data alone.
//
// A round states its display name (its historical designation, what a player reads; the key is
// never shown, and a round without a name does not load), its core material (a substance in
// `assets/materials/materials.ron` that carries material facts), its nose as geometry in calibres
// (the nose factor is DERIVED from it at load), its mass (kg), its calibre (m), its muzzle
// speed (m/s) and its crew line rate.
//
// A sub-calibre round adds `penetrator: Some((mass: (kg, Kind), caliber: (m, Kind)))`: the part of
// it that meets the plate, no heavier and no wider than the round, its nose the round's. The round
// flies whole (drag and the shell's view read its own mass and calibre) and meets the plate as its
// penetrator (the force law, the disc, overmatch and the cone's hole read the block). A round
// without the block meets the plate whole.
//
// `wound` = the crew line rate (ADR-0040): reference-mm of dose per metre of disc-mean chord the
// shell cuts through a crew box. Balance data, read by nothing in the hard walk. Scaled from the
// 30 HP crew pool (3 reference-mm, `ballistics::HP_PER_REFERENCE_MM`): a rate of `3 / L` empties
// the pool at a chord of `L` metres.
//
// A burst round adds `burst: Some((...))`: the burst core type it carries (a key of
// `burst_cores`, below), the burst shape it throws (`Ring` or `Ball`), the fuze's arming
// threshold (reference-mm spent in one body) and delay (s), the core's mass and the base parts'
// mass (kg), and the core cavity's diameter (m). Its parts (cavity length, wall and nose masses),
// its greatest sideways speed v_s = K (M/C + 1/2)^-1/2 and its driven mass's energy are DERIVED
// at load, never authored; the burst's story is design doc §5a, "The burst". A round without the
// block is inert, and a sub-calibre round carries none.
//
// PROVENANCE: every value is authored `(value, Kind("source or reason"))`, Kind one of Measured,
// Derived, Tuned, Resolution, Unknown (`src/provenance.rs`); a value without one does not load.
// "Q7" is the fixture-materials recommendation in
// `.agents/scratch/damage-cam-2026-10-08/research/hardness-anchor-free.md`, which collected no
// munition data: the rounds are labelled fixtures.
(
    rounds: {
        // The burst rounds of the owner's comparison (playtest fork F7): the Pzgr. 39's body
        // with its burst core, each throwing one of the two burst shapes. DERIVED at load from
        // the data below and the body's GunSteel density: a cavity of 36.4 cm³ and 36.3 mm length;
        // a wall of 1.440 kg and a nose of 8.370 kg; v_s 541.5 m/s under the ring (the wall
        // driven) and 205.8 m/s under the ball (the round less its core driven), 211.1 kJ and
        // 214.8 kJ of driven-mass energy. No source gives the nose's mass: DERIVED, provisional.
        "88mm_APHE_ring": (
            name: ("8.8 cm Pzgr. 39 ring", Tuned("the owner's comparison (brief 4b): the 8.8 cm
                Pzgr. 39 bursting as the ring")),
            core: ("GunSteel", Tuned("the Pzgr. 39's fixture body steel")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: the Pzgr. 39's blunt ogive of
                1 crh")),
            mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("the Pzgr. 39's main-gun rate, kept by the nose piece past the
                burst: the 30 HP crew pool is emptied at ~10 cm of chord (3 / 0.10)")),
            burst: Some((
                core_type: ("88mm_burst_core", Measured("the round's burst core:
                    tiger-ammo-history.md")),
                option: (Ring, Tuned("the owner's comparison (brief 4b): the wall becomes a band,
                    the nose piece flies on")),
                arming_spend: (35.0, Measured("the reference-mm the round spends in one body to
                    arm the fuze: tiger-ammo-history.md")),
                delay: (0.012, Measured("upper bound: tiger-ammo-history.md")),
                core_mass: (0.060, Measured("range 0.059-0.064 kg: tiger-ammo-history.md")),
                base_mass: (0.33, Measured("the trigger and trace element at the base, range
                    0.319-0.333 kg: tiger-ammo-history.md")),
                cavity_diameter: (0.0357, Tuned("provisional: the measured core diameter of the
                    round's predecessor (tiger-ammo-history.md); no source gives this round's")),
            )),
        ),
        "88mm_APHE_ball": (
            name: ("8.8 cm Pzgr. 39 ball", Tuned("the owner's comparison (brief 4b): the 8.8 cm
                Pzgr. 39 bursting as the ball")),
            core: ("GunSteel", Tuned("the Pzgr. 39's fixture body steel")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: the Pzgr. 39's blunt ogive of
                1 crh")),
            mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("the Pzgr. 39's main-gun rate: the 30 HP crew pool is emptied at
                ~10 cm of chord (3 / 0.10)")),
            burst: Some((
                core_type: ("88mm_burst_core", Measured("the round's burst core:
                    tiger-ammo-history.md")),
                option: (Ball, Tuned("the owner's comparison (brief 4b): one lobe of the round
                    less its core; nothing flies on")),
                arming_spend: (35.0, Measured("the reference-mm the round spends in one body to
                    arm the fuze: tiger-ammo-history.md")),
                delay: (0.012, Measured("upper bound: tiger-ammo-history.md")),
                core_mass: (0.060, Measured("range 0.059-0.064 kg: tiger-ammo-history.md")),
                base_mass: (0.33, Measured("the trigger and trace element at the base, range
                    0.319-0.333 kg: tiger-ammo-history.md")),
                cavity_diameter: (0.0357, Tuned("provisional: the measured core diameter of the
                    round's predecessor (tiger-ammo-history.md); no source gives this round's")),
            )),
        ),
        // The solid Pzgr. 39: the fixture round the pen cam scenarios and the field casts fire.
        "88mm_AP": (
            name: ("8.8 cm Pzgr. 39", Measured("the 8.8 cm KwK 36's APCBC round, whose 10.2 kg
                and 773 m/s this entry carries; en.wikipedia.org/wiki/8.8_cm_KwK_36, ammunition
                table")),
            core: ("GunSteel", Tuned("fixture label: a quenched-and-tempered 4340-class alloy-steel
                body, the class Q7 recommends for the large round; GunSteel carries that class's
                facts. The rigid regime reads no core fact")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: a blunt ogive of 1 crh")),
            mass: (10.2, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (773.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("a main-gun round empties the 30 HP crew pool at ~10 cm of chord
                (3 / 0.10): a clean pass through a station knocks it out, a graze of its edge
                leaves it reduced (crew-model decision 2026-10-17)")),
        ),
        "88mm_APCR": (
            name: ("8.8 cm Pzgr. 40", Measured("the 8.8 cm KwK 36's APCR round; Jentz & Doyle,
                Tiger I Heavy Tank 1942-45, Osprey New Vanguard 5 (1993), p.17")),
            core: ("TungstenCarbide", Measured("the round's 1.93 kg core is tungsten carbide: US
                Army TM 9-1985-3, German Explosive Ordnance (Projectiles and Projectile Fuzes),
                March 1953, pp.439-440. The rigid regime reads no core fact")),
            nose: (Ogive(crh: 1.0), Tuned("labelled fixture value: the Pzgr. 39's blunt ogive of
                1 crh")),
            // The round flies as its whole body and meets the plate as its core (`penetrator`
            // below): at the muzzle the core reads about 180 reference-mm against the Pzgr. 39's
            // about 115 (DERIVED from the force law with the shipped RHA facts; read as its whole
            // body it would be about 112), a ratio of 1.57 against the record's about 1.4 (Jentz
            // & Doyle: more at the muzzle, less behind the plate), and its cone's hole term is
            // (35.7 / 88)² = 0.165 (DERIVED). Still provisional: the core's nose is the round's,
            // a labelled fixture, and the rigid rule reads no fact of the core.
            mass: (7.3, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            caliber: (0.088, Measured("the gun's nominal 8.8 cm calibre designation")),
            muzzle_speed: (930.0, Measured("Jentz & Doyle, Tiger I Heavy Tank 1942-45, Osprey New
                Vanguard 5 (1993), p.17")),
            wound: (30.0, Tuned("the Pzgr. 39's main-gun rate: the 30 HP crew pool is emptied at
                ~10 cm of chord (3 / 0.10)")),
            penetrator: Some((
                mass: (1.93, Measured("the tungsten-carbide core, 4.25 lb: US Army TM 9-1985-3,
                    German Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953,
                    pp.439-440; the conversion to kg is DERIVED")),
                caliber: (0.0357, Measured("the core's diameter, 1.406 in: US Army TM 9-1985-3,
                    German Explosive Ordnance (Projectiles and Projectile Fuzes), March 1953,
                    pp.439-440; the conversion to m is DERIVED")),
            )),
        ),
        "7.9mm_AP": (
            name: ("7.92 mm S.m.K.", Measured("Spitzgeschoss mit Kern, the German 7.92 mm
                steel-cored armour-piercing bullet (panzerworld.com/german-ammunition-nomenclature;
                en.wikipedia.org/wiki/7.92x94mm_Patronen). The best-attested match: this entry's
                mass and speed are unsourced and not tied to it")),
            core: ("GunSteel", Tuned("fixture label: a quenched-and-tempered alloy-steel core,
                Q7's 'hardened' belt; GunSteel carries that class's facts. The rigid regime reads
                no core fact")),
            nose: (Cap(radius_calibres: 0.5), Tuned("labelled fixture value: round-nosed, a
                hemispherical cap")),
            mass: (0.0118, Unknown("no source recorded in the repo; settled by a cited munition
                table")),
            caliber: (0.0079, Unknown("rounded from the 7.92 mm nominal designation; whether the
                bore or the bullet diameter is meant is not recorded")),
            muzzle_speed: (755.0, Unknown("no source recorded in the repo; settled by a cited
                firing table")),
            wound: (10.0, Tuned("a rifle-calibre bullet empties the 30 HP crew pool at ~30 cm of
                chord (3 / 0.30): one pass through a station leaves it reduced, two knock it out
                (crew-model decision 2026-10-17)")),
        ),
    },
    // Burst core types by key: a burst block names one. Each carries its density (kg/m³) and its
    // speed constant K (m/s), the sideways speed scale of v_s.
    burst_cores: {
        "88mm_burst_core": (
            density: (1650.0, Derived("1.65 g/cm³: shape-law.md §4")),
            speed_constant_mps: (2680.0, Derived("shape-law.md §4")),
        ),
    },
)
