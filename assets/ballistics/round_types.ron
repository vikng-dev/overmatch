// Subject: the game's damage model and authored presentation; game state only.
// The round-type table: a round's construction class and the shape proxy it implies, keyed by
// the name a round file's `round_type` gives (`src/rounds.rs`). A row states its flight nose and
// its hit nose (`NoseShape`, geometry in calibres) and its carrier: `None` for a round that meets
// the plate whole, `Kept` for a sub-calibre core that reaches the plate in its carrier, `Discarded`
// for one whose carrier leaves it in flight. A round of a type with a carrier authors a penetrator
// block, and a round of a type without one does not.
//
// The flight nose is what drag reads: the drag form is a base share plus a nose share × the flight
// nose's factor (`ballistics::DragLaw`), so a pointed flight nose keeps more speed downrange. The
// `drag` block states the law's parameters: the base drag coefficient, and one anchor nose with the
// form it flies on (form units: a drag coefficient × ρπ/8, ρ = 1.225 kg/m³, so 0.4811 form units per
// unit drag coefficient, DERIVED); the nose share is DERIVED from the two. A
// ballistic-capped type flies on its cap's pointed nose and meets the plate with the blunt nose
// under it. Flight and hit proxies are authored independently; the AP row keeps its fixture hit
// nose while assuming a pointed flight nose. The carrier decides which body flies: the
// whole round, or the penetrator where the carrier is discarded.
//
// The hit nose is what the force law reads: a round's nose factor is DERIVED from it at load,
// unless the round overrides it with a `nose` of its own. A round's override is of its hit nose
// alone; it flies on its type's flight nose.
//
// PROVENANCE: every value is authored `(value, Kind("source or reason"))` (`src/provenance.rs`);
// a value without one does not load.
(
    drag: (
        base_drag_coefficient: (0.20, StandIn("Stand-in for Mach-dependent drag: ASSUMED: base drag
            plus skin friction at shell speeds; no aerodynamic source read. 0.0962 form units,
            DERIVED")),
        anchor_nose: (Ogive(crh: 1.0), StandIn("Stand-in for Mach-dependent drag: the chosen
            calibration convention for the fixed drag form, a 1-crh
            tangent ogive, nose factor 7/24 (DERIVED)")),
        anchor_form: (0.263, StandIn("Stand-in for Mach-dependent drag: provisional: hand-set so a
            10.2 kg 88 mm round flying on the anchor nose has k = 2.0e-4 1/m (DERIVED); a drag
            coefficient of 0.547 (DERIVED: 0.263 / 0.4811). No aerodynamic source read; replace both
            values from measured or published drag data")),
    ),
    round_types: {
        // High-explosive, full calibre, a nose fuze in its ogive.
        "HE": (
            flight_nose: (Ogive(crh: 4.0), Unknown("ASSUMED: the APCBC's ogive; no source in the
                research note gives the shell's nose. Settled by a sourced drawing of this
                construction class's flight nose")),
            hit_nose: (Ogive(crh: 4.0), Unknown("ASSUMED: the flight nose; no cap. Settled by a
                sourced drawing of this construction class's hit nose")),
            carrier: (None, Derived("full-calibre round")),
        ),
        // Armour-piercing, capped and ballistic-capped.
        "APCBC": (
            flight_nose: (Ogive(crh: 4.0), Unknown("owner-accepted starting point 2026-10-28: the
                ballistic cap's pointed ogive over the blunt hit nose. Settled by a sourced drawing
                of the ballistic cap ogive")),
            hit_nose: (Ogive(crh: 1.0), Unknown("unverified physical proxy: the Pzgr. 39's blunt
                ogive of 1 crh. Settled by a sourced drawing of the blunt ogive beneath the cap")),
            carrier: (None, Derived("a full-calibre round: the whole round meets the plate")),
        ),
        // Armour-piercing, composite rigid: a hard core in a light full-calibre body.
        "APCR": (
            flight_nose: (Ogive(crh: 1.0), Unknown("no ballistic cap in this table: the round flies
                on its hit nose, the drag form's blunt anchor. Settled by a sourced drawing of this
                rigid composite construction flight nose")),
            hit_nose: (Ogive(crh: 1.0), Unknown("unverified physical proxy: the Pzgr. 39's blunt
                ogive of 1 crh. Settled by a sourced drawing of this rigid composite construction
                hit nose")),
            carrier: (Kept, Derived("the core reaches the plate inside its full-calibre body: the
                round flies whole and meets the plate as its core")),
        ),
        // Armour-piercing small-arms bullet.
        "AP": (
            flight_nose: (Ogive(crh: 6.0), Unknown("a pointed rifle bullet: a 6-crh tangent ogive,
                ASSUMED as a typical spitzer's, its nose 2.4 calibres long (DERIVED); no source in
                the repo states the bullet's ogive. Settled by a sourced drawing of the pointed
                bullet flight nose")),
            hit_nose: (Cap(radius_calibres: 0.5), Unknown("unverified physical proxy: a
                hemispherical cap. Settled by a sourced drawing of the bullet hit nose")),
            carrier: (None, Derived("a full-calibre bullet: the whole round meets the plate")),
        ),
    },
)
