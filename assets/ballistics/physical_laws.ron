// The game's environment destruction and damage model: shared physical parameters and metric field fits.
(
    gravity_mps2: (9.81, StandIn("Uniform Earth-like gravity; no map-specific gravity model")),
    air_density: (1.225, StandIn("One sea-level atmosphere pending weather and altitude")),
    cavity_inertia: (1.0, StandIn("Approximate cavity inertia fit pending material-specific calibration")),
    plate_capacity: ((shear_slope: 1.35, opening_share: 0.49, return_power: 1.5),
        StandIn("Missing material-and-construction law for integrated plate-opening work: this global work-share fit is replaced when that law supplies the thin-to-bulk transition. shear_slope 1.35 sets the low-thickness F band (x=0.10, 0.20, 0.25, 0.30); opening_share 0.49 sets the plateau from the one x=0.50 by-eye row; return_power 1.5 sets the return shape from the one x=0.65 printed row, constrained below 2 for fixed-mass calibre ordering. Any positive return_power joins bulk; its fitted magnitude does not establish that join. The x=0.24 interpolation is a check, not an independent row. Design doc section 3b (#263) records the firing comparisons and unsupported near-calibre band")),
    contact_friction: (0.5, StandIn("Coulomb coefficient at which a face holds a round in one contact: the low end of the general dry steel range 0.5 to 0.8, no source read; stands in for a value per surface pair")),
    server_rubble_min_size_m: (0.5, Resolution("The game's environment destruction: the server's rubble resolution, the cube root of occupied fragment volume, m, from which it simulates a fragment as a body whatever its mass; the same for every material. Cost: a volume V of collapsed matter leaves at most V / size^3 bodies this way, each costing contact, solver and sweep work every tick on the hosted allocation, which #306 prices. Matter below it rides with a parted neighbour leaving with it, or becomes decoration that no hull or round meets")),
    server_rubble_hull_kg: (100.0, Taste("The game's environment destruction: driving through rubble. The lightest fragment the server keeps as a body below its rubble resolution, kg, so that a hull meets the matter it would feel: a plastic exchange with a hull of 50 t or more moves the hull's speed by m/(m+M), under 0.2 % for anything lighter (DERIVED). The crumble's seams, not this number, decide how many fragments a landing makes")),
    ground_youngs_modulus_pa: (3.0e7, Unknown("The game's environment destruction: the ground's Young's modulus, its side of a landing's contact stiffness. The maps' soil is not characterized; 30 MPa sits where the medium clay (20.7-41.4 MPa) and medium dense sand (17.3-27.6 MPa) rows of Das, Principles of Foundation Engineering, 'Elastic parameters of various soils', meet (recalled, the table not read here). Settled by a plate-load test of the map's soil, or a soil class per map")),
    ground_poisson_ratio: (0.3, Unknown("The ground's Poisson's ratio, beside ground_youngs_modulus_pa: inside the 0.20-0.40 sand and 0.20-0.50 clay ranges of the same Das table (recalled, not read here). Settled with the modulus")),
    tnt_energy_j_per_kg: (4.184e6, Unit("TNT-equivalent energy convention, joules per kilogram")),
    surface_burst_factor: (1.8, StandIn("Claimed UFC 3-340-02 surface/free-air equivalence; source verification pending, same existing model factor")),
    reflected_impulse: ((
        from: 0.06,
        branches: [(40.0, [6.7853, -1.3466, 0.101, -0.01123])],
    ), Measured("Swisdak 1994, Simplified Kingery Airblast Calculations, DTIC ADA526744, Table 1 metric normally reflected impulse, PDF page 10; coefficients transcribed by the existing model")),
    incident_impulse: ((
        from: 0.2,
        branches: [
            (0.96, [5.522, 1.117, 0.6, -0.292, -0.087]),
            (2.38, [5.465, -0.308, -1.464, 1.362, -0.432]),
            (33.7, [5.2749, -0.4677, -0.2499, 0.0588, -0.00554]),
            (158.7, [5.9825, -1.062]),
        ],
    ), Measured("Swisdak 1994, DTIC ADA526744, Table 1 metric incident impulse, PDF page 9; coefficients transcribed by the existing model")),
    incident_pressure: ((
        from: 0.2,
        branches: [
            (2.9, [7.2106, -2.1069, -0.3229, 0.1117, 0.0685]),
            (23.8, [7.5938, -3.0523, 0.40977, 0.0261, -0.01267]),
            (198.5, [6.0536, -1.4066]),
        ],
    ), Measured("Swisdak 1994, DTIC ADA526744, Table 1 metric incident peak pressure, PDF page 8; coefficients transcribed by the existing model")),
    reflected_pressure: ((
        from: 0.06,
        branches: [
            (
                2.0,
                [9.006, -2.6893, -0.6295, 0.1011, 0.29255, 0.13505, 0.019736],
            ),
            (
                40.0,
                [8.8396, -1.733, -2.64, 2.293, -0.8232, 0.14247, -0.0099],
            ),
        ],
    ), Measured("Swisdak 1994, DTIC ADA526744, Table 1 metric normally reflected peak pressure, PDF page 8; coefficients transcribed by the existing model")),
)
