    view_pending_s: (0.250, Taste("shot presentation: wait this many view seconds for a released fact's shooter rig before omitting its cosmetic")),
    view_cut_s: (0.250, Taste("view continuity: simulation backlog above this duration cuts; floored by the server admission cap")),
    uplink_window_s: (10.0, Taste("link tolerance memory: retain input arrival gaps for this many seconds")),
    stale_floor_s: (0.100, Taste("minimum input silence tolerance in seconds")),
    stale_ceil_s: (0.250, Taste("maximum input silence tolerance in seconds")),
    recovery_fresh_copies: (2, Taste("input recovery tolerance: keep a pending edge eligible across this many sends, including its first copy")),
