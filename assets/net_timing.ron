(
    admission_s: (0.250, Taste("server time admission: maximum simulation debt admitted from one wall-time batch; also the view continuity floor")),
    view_window_s: (10.0, Taste("view buffering memory: retain frame-start-to-arrival lateness for this many seconds")),
