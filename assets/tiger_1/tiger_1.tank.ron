#![enable(implicit_some)]
TankSpec(
    // The name a player reads for this vehicle (knockout feed, pen cam).
    display_name: "Tiger I",
    mass: 57_000.0,
    inertia_extents: (3.0, 2.0, 6.3),
    // The game's damage model (game state only): assembly mass in kg and full inertia-box
    // extents in m. Unknown provisional mass and dimensions; assembly weighing and moment
    // measurements would settle them. Servo law and derivation: design
    // armor-penetration-and-damage.md section 7c.
    turret: (
        node: Some("Turret_Yaw"),
        mass: (8_000.0, Unknown("provisional assembly kg; weighing the complete assembly would settle it")),
        inertia_extents: ((3.0, 1.2, 2.4), Unknown("provisional full inertia-box metres; assembly moment measurements would settle them")),
    ),
    gunner_yaw: Some("Turret_Yaw"),
    // Continuous track (track architecture §7). link_count 97 = the marker-derived window's
    // lowest SPRING-limited count (window 95..96 at ride_frequency 1.2 Hz): full suspension
    // travel with the minimum slack that permits it — playtest-confirmed 2026-07-24. The real
    // Tiger ran 96/side (chain-limited, as a tensioned track is); revisit if belt-tension
    // forces ever land. Window recomputes when ride_frequency moves — recheck after retuning.
    // This block is authored VEHICLE DATA: link count, link physicals, articulation limits, the
    // sprocket teeth and tooth datums, the pin planes, the idler radii and the ride / powertrain
    // models; each station's tread is in `roadwheels`. The common shoe template (pitch, plate
    // thickness, shoe faces) is MEASURED off the glb's link markers, and the axle centres are the
    // declared nodes' positions (see track::rig_geom / track::marker_model).
    track: (
        // MEASURED from the sim artifact's pin markers; the shared shoe template is mirrored on the left.
        pin_plane_x: (left: -1.5283124446868896, right: 1.5283124446868896),
        // The `materials.ron` row the links are of: its friction is the track's side of every
        // contact pair, the belt on the ground or a piece, and its bump stops and side plates.
        substance: "TrackSteel",
        link_count: 97,
        link_mass: (30.0, Unknown("Complete shoe, pin and connector assembly mass is unverified; weigh an assembly or obtain a parts-manual mass to replace this provisional 30 kg")),
        hinge_torque: 45.0,
        // Hard articulation stops, in DEGREES (the `_deg` suffix is the unit contract; `spec.rs`
        // converts to radians once, at the deserialisation seam — nothing downstream sees
        // degrees). ASYMMETRIC because the shoe is: folding INWARD (toward the wheels) the guide
        // horns close on each other, folding OUTWARD (away from them) the ground-side structure
        // does. Two different features, two different numbers, both authored as POSITIVE
        // magnitudes named for their direction — a signed pair here is a sign convention waiting
        // to be read backwards.
        //   inward  40° — the WRAP direction: every wheel the belt bends around costs a fold this
        //           way (the tightest, the idler, demands 20.44°).
        //   outward 18° — a return run sagging, a shoe cresting a rock.
        // HAND-MEASURED in Blender, not derived. An automatic mesh sweep was built and rejected:
        // the shoe is modelled with near-zero clearance (~18 µm at the outward faces), so the
        // first-contact angle it reported moved with the penetration threshold (17.7° at 0.1 mm,
        // 42.9° at 0.5 mm, 46.0° at 2 mm) — an arbitrary number wearing a measurement's clothes.
        // And the mesh is only ever an UPPER BOUND anyway: real articulation is also limited by
        // pin/bushing clearance and the end connectors, none of which the shoe mesh models.
        link_angle: ( inward_deg: 40.0, outward_deg: 18.0 ),
        // 20 teeth (model-verified count). The pitch radius is chord-exact from the MEASURED
        // pitch × teeth (marker-derived, ~0.4155 m); the sprocket centre is its declared node's.
        // Reductions absorb the radius (speeds are anchored), so the tooth count is feel-neutral
        // for the transmission.
        //
        // MEASURED from each sim sprocket's reference tooth in the hull side plane (rad).
        sprocket: ( spin_inertia_kgm2: ((left: 26.0, right: 26.0), Unknown("No assembly axial moment measured; provisional rounded uniform-disc estimate from assumed 300 kg and 0.416 m radius. Settle with the complete sprocket mass distribution or a spin test")), teeth: 20, tooth_tip_rad: (left: 0.001790004, right: 0.002023177), nodes: ( left: "Sprocket_L", right: "Sprocket_R" ) ),
        // The idler meshes' view nodes, one per side.
        // MEASURED contact radii from the sim artifact's two idlers (m).
        idler: ( spin_inertia_kgm2: ((left: 12.0, right: 12.0), Unknown("No assembly axial moment measured; provisional rounded uniform-disc estimate from assumed 200 kg and 0.34 m radius. Settle with complete idler mass distribution or a spin test")), radius: (left: 0.34000003, right: 0.34000003), nodes: ( left: "Idler_L", right: "Idler_R" ) ),
        // Belt inertia is DERIVED from the links and every declared rotating wheel assembly.
        // The crank/flywheel inertia remains engine-side in the transmission below.
        powertrain: (
            // The DECLARED drivetrain (phase 2.5) — authored from the anchored tables in
            // .agents/docs/design/track-model/tiger-transmission-data.md. It SHIPS everywhere, MP
            // included (REV 14 replicates the full TransmissionState atomically).
            // Architecture: "wheel controlled hydraulic operated regenerative" [ANCHOR] — the
            // L600 fixed-radius box, the one law `track::transmission` runs.
            transmission: (
                engine: (
                    // HL230 P45. idle INFERRED (~600, typical for the engine class);
                    // governed 2500 = the fleet condition from Nov 1943 [ANCHOR]; per-gear
                    // speed anchors are quoted @ 3000 [ANCHOR].
                    idle_rpm: 600.0,
                    governed_rpm: 2500.0,
                    crank_limit_rpm: (3000.0, Measured("Tigerfibel p.38: tachometer instruction never over 3000 rpm; independent of the torque curve")),
                    rated_rpm: 3000.0,
                    // V-12 [ANCHOR]. Four-stroke, so the crank fires 6 times per revolution:
                    // 60 Hz at idle, 250 Hz at the governor.
                    cylinders: 12,
                    // No `sound` block: the engine is silent until a loop worthy of the HL230
                    // exists (a `sound` is `(clip, clip_pop_hz)` — the pop rate MEASURED off the
                    // file at playback speed 1.0; `sfx` derives the rpm→playback-speed mapping
                    // from those two numbers and the rpm band above).
                    // (rpm, N·m): 800→1300 INFERRED (~0.70 × peak); 2100→1850 ANCHOR
                    // (medium); 2500→1686 DERIVED (600 PS); 3000→1639 DERIVED (700 PS).
                    torque_curve: [(800.0, 1300.0), (2100.0, 1850.0), (2500.0, 1686.0), (3000.0, 1639.0)],
                    // Compression braking at zero throttle: the MID-BAND anchor of
                    // the rising motoring-torque curve, as a fraction of peak torque.
                    // The sim's motoring torque equals drag_fraction × peak at
                    // ω_mid = (idle + governed)/2 = 1550 rpm and grows linearly with
                    // crank speed (1/3 base + 2/3 linear — pumping/friction losses
                    // rise with speed; ≈ 1.41× at governed, ≈ 1.62× at rated), so each
                    // gear has a bounded downhill equilibrium. Motoring runs ~20–30%
                    // of rated torque mid-band — INFERRED (no HL230 motoring curve
                    // reachable).
                    drag_fraction: 0.25,
                    // Crank + flywheel + main-clutch inertia J (kg·m²), the
                    // engine crank state. INFERRED by engine-class scaling (no HL230
                    // flywheel datum reachable): large multi-cylinder tank diesels/petrols
                    // land in a 2.5–6 kg·m² band, flywheel-dominant (a ~0.5 m, ~50–80 kg
                    // flywheel rim alone is 2–4 kg·m²; crank + clutch add the rest) —
                    // mid-band 4.0.
                    inertia_kgm2: 4.0,
                    // ASSUMED dry-clutch sizing margin: DERIVED about 1.3 × the
                    // 1850 N·m peak, rounded to 2400 N·m; no Argus/OLVAR rating available.
                    // This bounds transmitted torque; launch slip transmits available
                    // free torque, up to this capacity.
                    clutch_capacity_nm: 2400.0,
                ),
                gearbox: (
                    // OLVAR OG 40 12 16, 8F/4R [ANCHOR]. Per-gear top speeds @ 3000 rpm
                    // [ANCHOR — hamby / Jentz]; R1–R4 mirror F1–F4 [ANCHOR]. Reductions
                    // derive at build against the spec's own sprocket radius (the
                    // 19-vs-20-tooth discrepancy rule). DERIVED F8 @ governed 2500 → 10.509 m/s.
                    forward_speeds_kmh: [2.8, 4.3, 6.2, 9.2, 14.1, 20.9, 30.5, 45.4],
                    reverse_speeds_kmh: [2.8, 4.3, 6.2, 9.2],
                    // Measured: operating instructions allow starting in gears 1-4 and
                    // skipping at most two gears (one event spans three), Fibel pp.40-41.
                    launch_gears: 4,
                    max_step: 3,
                    // OLVAR preselector: pre-selected shifts complete with drive uncoupled
                    // for a noticeable fraction of a second — INFERRED ~0.31 s, no shift-
                    // time datum reached.
                    shift_secs: 0.31,
                ),
                steering: (
                    // (R_tight, R_wide) per forward gear (m): anchored at BOTH corners
                    // (3.44 m F1-tight, 165 m F8-wide), R ∝ 1/G within each step, tight:wide
                    // = 2.958 per gear [DERIVED — tiger-transmission-data.md table].
                    radii: [
                        (3.44,  10.2),
                        (5.28,  15.6),
                        (7.62,  22.5),
                        (11.30, 33.4),
                        (17.32, 51.2),
                        (25.68, 76.0),
                        (37.47, 110.8),
                        (55.78, 165.0),
                    ],
                    // DERIVED: these reverse gears have the same speed anchors as the first four
                    // forward gears; each reverse row states its own construction radius.
                    reverse_radii: [(3.44, 10.2), (5.28, 15.6), (7.62, 22.5), (11.30, 33.4)],
                    // Steering-member force capacity PER OUTPUT (N): the grip-limit
                    // gearing rule's per-track datum (≈ μ·W/2, same as `force`). The
                    // member drives the two outputs DIFFERENTIALLY, so the belt-difference
                    // axis F_s is bounded by 2× this: 500 kN → 745 kN·m of yaw moment
                    // against DERIVED ~478 kN·m footprint scrub: breakaway ratio 1.56.
                    // Treating capacity as the total difference-axis bound instead yields
                    // DERIVED 373 kN·m, below scrub. INFERRED sizing; no published
                    // steering-member torque rating reachable.
                    capacity: 250_000.0,
                    // Neutral differential speed is DERIVED from first-gear construction:
                    // neutral_d_full = κ_tight(F1) × v1_governed. An authored share would
                    // replace this radii/speed relationship with an unprovenanced feel scalar.
                    // Mechanical recirculation efficiency ~0.9 — INFERRED.
                    recirculation: 0.9,
                ),
                // Per-side brake capacity at the sprocket, with two DERIVED anchors:
                //   (1) the settled 20° park-hold capability (ADR-0026 records 20°
                //       holds; the test course has 20° ramps): W·sin 20°/2 =
                //       57 000 × 9.81 × 0.342 / 2 ≈ 95.6 kN/side — 96 kN holds it
                //       with margin;
                //   (2) 192 kN total = 0.343 g service decel — inside the 0.2–0.35 g
                //       historical band for WWII heavy tanks (even modern heavy trucks
                //       certify ~0.5 g).
                // Rejected grip-limit sizing is circular: 250 kN sized against
                // μ·W/2 — the very friction it was meant to be tested by — and implied
                // DERIVED 2.9 MW through two 1940s Argus discs at speed: energy-impossible.
                // The dynamic datum still governs every moving slide and service-brake stop;
                // static breakaway is authored separately below.
                brake_force: 96_000.0,
                // INFERRED provisional — static breakaway vs dynamic dissipation are different
                // physical limits (static hold does no work; sourced material ratios span
                // 1.05–2.0×). The Tiger's Argus discs are documented as self-energizing in both
                // British Report No. 19 and D 656/30, but no numerical Argus rating
                // survives; supersede when sourced. At 1.5×, the DERIVED static capacity is
                // 2 × 96,000 × 1.5 = 288,000 N total against the DERIVED 30° demand
                // 57,000 × 9.81 × sin(30°) = 279,585 N: an 8,415 N DERIVED margin.
                brake_static_factor: 1.5,
            ),
        ),
        // The ride model — everything else derives: spring rate m·(2πf)², static deflection
        // g/(2πf)² ≈ 0.173 m (the droop envelope depth, chain-clamped by the link window),
        // damper 2ζ√(k·m). Real tanks ride at ~1–1.5 Hz.
        suspension: (
            ride_frequency: 1.2, // Hz
            damping_ratio: 0.35,
            // Compression travel above rest (m) — the red hard stop. Tuned in the sandbox
            // 2026-07-24: raised until the compression wrap clears the hull; note the belly
            // hand-off — past ~0.15 m (DERIVED: idler rim bottom minus road-wheel rim bottom, off
            // the mesh) the unsprung idler/sprocket own the red belly, so the extra travel here
            // mostly widens the per-wheel stop, not the collider floor.
            bump_stop: 0.200,
            // Contact engage-ramp depth (m): the penetration over which a contact ramps from
            // zero to full support — the anti-pop smoothing of the contact law.
            engage: 0.02,
        ),
    ),
    // Law, limitations and DERIVED rate comparisons live in design
    // armor-penetration-and-damage.md section 7c. No drive fact below is a measured datum.
    servos: {
        "Turret_Yaw": (
            role: Yaw,
            drive: Powered(
                power_share: (0.01, Unknown("provisional crank-power share; traverse pump pressure, flow and efficiency versus crank rpm would settle it")),
                stall_torque: (16_000.0, Unknown("provisional output N m; hydraulic motor stall pressure, displacement and reduction data would settle it")),
                bearing_friction: (8_000.0, Unknown("provisional running N m; unpowered assembly bearing-drag measurements would settle it")),
                hand_rate: (1.0, Unknown("provisional degrees/s; handwheel ratio and sustained operator turn-rate measurements would settle it")),
            ),
            travel: Continuous,
            requires: [Gunner],
        ),
        "Main_Gun_Pitch": (
            role: Pitch,
            drive: Powered(
                power_share: (0.002, Unknown("provisional crank-power share; elevation-drive pressure, flow and efficiency data would settle it")),
                stall_torque: (5_000.0, Unknown("provisional output N m; elevation-drive stall torque and reduction data would settle it")),
                bearing_friction: (2_500.0, Unknown("provisional running N m; unpowered elevation bearing-drag measurements would settle it")),
                hand_rate: (0.5, Unknown("provisional degrees/s; elevation handwheel ratio and operator turn-rate measurements would settle it")),
            ),
            travel: Limited(min: -8.0, max: 15.0),
            requires: [Gunner],
        ),
        "Hull_MG_Yaw": (
            role: Yaw,
            drive: Hand(hand_rate: (45.0, Unknown("provisional degrees/s; operator ball-mount sweep measurements would settle it"))),
            travel: Limited(min: -30.0, max: 30.0),
            requires: [BowGunner],
        ),
        "Hull_MG_Pitch": (
            role: Pitch,
            drive: Hand(hand_rate: (45.0, Unknown("provisional degrees/s; operator ball-mount sweep measurements would settle it"))),
            travel: Limited(min: -10.0, max: 20.0),
            requires: [BowGunner],
        ),
    },
    // DECLARED ARMOUR (design §12). A node is a ballistic volume iff it is a key here, whatever
    // material it wears; a node wearing a registry substance and not keyed here is view geometry.
    // The substance a declared node wears (assets/materials/materials.ron, linked in from
    // assets/materials/materials.blend) supplies its resistance, keyed by substance name. Each
    // entry says what the volume is beyond armour: main armour `(main: true)`, external armour
    // `(external: true)`, or a component with an hp pool and consequence facets (crew / ammo /
    // function). A key naming no ballistic volume fails loud at bind, a witness substance (Flesh)
    // with no crew facet is refused at load, and every part a gate requires must be a facet some
    // volume here declares.
    volumes: {
        // hp is in whole HP points: the line's dose converts at ballistics::HP_PER_REFERENCE_MM,
        // the field's at assets/ballistics/spall_cone.ron's calibration. A crew station authors
        // no hp: its pool is the shared crew pool (assets/ballistics/box_classes.ron). Every other
        // pool is authored here by hand and tuned in play; no rule ties it to the box's size.
        // --- Main armour: plates and shells with nothing to declare beyond resisting a round ---
        "Coax_MG_Body":      (main: true),
        "Commander_Cupola":  (main: true),
        "Commander_Hatch":   (main: true),
        "Gun_Mantlet":       (main: true),
        "Gun_Mask":          (main: true),
        "Hull_Bottom":       (main: true),
        "Hull_LFP_Lower":    (main: true),
        "Hull_LFP_Upper":    (main: true),
        "Hull_MG_Ball":      (main: true),
        "Hull_MG_Body":      (main: true),
        "Hull_MG_Mantlet":   (main: true),
        "Hull_Rear":         (main: true),
        "Hull_Side_Lower_L": (main: true),
        "Hull_Side_Lower_R": (main: true),
        "Hull_Side_Track_L": (main: true),
        "Hull_Side_Track_R": (main: true),
        "Hull_Side_Upper_L": (main: true),
        "Hull_Side_Upper_R": (main: true),
        "Hull_Top":          (main: true),
        "Hull_UFP_Lower":    (main: true),
        "Hull_UFP_Upper":    (main: true),
        "Turret_Bottom":     (main: true),
        "Turret_Mask":       (main: true),
        "Turret_Side":       (main: true),
        "Turret_Top":        (main: true),
        // --- Modules (hp = integrity; the substance carries resistance, independently) ---
        "Engine":           (hp: 336, function: Engine),
        "Transmission":     (hp: 479, function: Transmission),
        "Breech":           (hp: 142, function: Breech),
        "Main_Gun_Barrel":  (hp: 250, function: GunBarrel),
        // Each MG barrel serves its own weapon's barrel function, which that weapon's fire gate
        // names, as the main gun's does.
        "Coax_MG_Barrel":   (hp:   4, function: CoaxMgBarrel),
        "Hull_MG_Barrel":   (hp:   4, function: BowMgBarrel),
        // --- Crew --- the shared crew pool; an hp here does not load.
        "Commander":        (crew: Commander),
        "Gunner":           (crew: Gunner),
        "Loader":           (crew: Loader),
        "Driver":           (crew: Driver),
        "BowGunner":        (crew: BowGunner),
        // --- Ammunition (ammo: true means cookoff when its HP pool empties) ---
        "Ammo_L_0":         (hp:  72, ammo: true),
        "Ammo_L_1":         (hp:  72, ammo: true),
        "Ammo_R_0":         (hp:  72, ammo: true),
        "Ammo_R_1":         (hp:  72, ammo: true),
        // --- Smoke launchers: damageable, deliberately INERT. They carry an hp pool so the round
        // that shears one off is recorded, and no `function`, because nothing fires them yet. The
        // facet is the seam the smoke-discharger work binds to; until then losing one costs the
        // vehicle nothing.
        "Smoke_Launcher_0": (hp:  14),
        "Smoke_Launcher_1": (hp:  13),
        "Smoke_Launcher_2": (hp:  11),
        "Smoke_Launcher_3": (hp:  11),
        "Smoke_Launcher_4": (hp:  13),
        "Smoke_Launcher_5": (hp:  14),
        // --- External armour: the running gear outside the hull sides. It resists like any armour;
        // perforating it is not a penetration of the tank (the pen cam's shot verdict). The track
        // links wear no substance and are not volumes; the Tiger carries no skirts.
        "Sprocket_L":       (external: true),
        "Sprocket_R":       (external: true),
        "Idler_L":          (external: true),
        "Idler_R":          (external: true),
        "Wheel_L_0":        (external: true),
        "Wheel_L_1":        (external: true),
        "Wheel_L_2":        (external: true),
        "Wheel_L_3":        (external: true),
        "Wheel_L_4":        (external: true),
        "Wheel_L_5":        (external: true),
        "Wheel_L_6":        (external: true),
        "Wheel_L_7":        (external: true),
        "Wheel_R_0":        (external: true),
        "Wheel_R_1":        (external: true),
        "Wheel_R_2":        (external: true),
        "Wheel_R_3":        (external: true),
        "Wheel_R_4":        (external: true),
        "Wheel_R_5":        (external: true),
        "Wheel_R_6":        (external: true),
        "Wheel_R_7":        (external: true),
    },
    // Collision proxies (one convex hull per loose part, Vehicle layer) — DECLARED, replacing the `*_Collider` suffix
    // scan. The suffix survives as a name because it reads well in Blender; nothing parses it.
    // `substance` is the `materials.ron` row whose friction the proxy's hulls carry: the rolled
    // armour both stand in for.
    colliders: [
        (node: "Hull_Collider", substance: "RHA"),
        (node: "Turret_Collider", substance: "RHA"),
    ],
    // Shadow proxies: beyond the caster switch range each casts the shadow of the rigid node it is
    // parented under, in place of that node's drawn geometry (tank::shadow_proxy). The two colliders
    // stand in for the hull and the turret; Main_Gun_Barrel_Shadow, a shadow-only tube under the
    // recoiling barrel node, stands in for the barrel (authored by .agents/blender/shadow_tube.py).
    shadow_proxies: ["Hull_Collider", "Turret_Collider", "Main_Gun_Barrel_Shadow"],
    // Roadwheel stations — DECLARED, replacing the `Wheel_{L,R}_{n}` pattern match. The SAME node is
    // the suspension station and its own armour volume: each wheel is one object holding five closed
    // shells — two MildSteel bodies, two Rubber rims, one axle — declared armour in `volumes`
    // above, and it needs its station role and side stated here. ORDER IS LOAD-BEARING: this is
    // the `WheelIndex` slot order both wire ends derive.
    // MEASURED per-station tread radius and the two Rubber-shell lateral spans in the sim artifact.
    // Spans are hull-X offsets from the station's authored axle, in metres.
    roadwheels: [
        (node: "Wheel_L_0", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_1", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_2", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_3", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_4", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_5", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_6", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
        (node: "Wheel_L_7", side: Left, spin_inertia_kgm2: (32.0, Unknown("Complete station assembly axial moment is unmeasured; provisional uniform-disc estimate from assumed 400 kg at the declared 0.4 m tread radius. Settle with all rotating discs at this axle, their masses and radial distributions, or a spin test")), tread: (radius: 0.4, spans: [(-0.17056572, -0.07175010), (0.18154858, 0.28036344)])),
