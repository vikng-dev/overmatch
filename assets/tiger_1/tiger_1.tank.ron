#![enable(implicit_some)]
TankSpec(
    mass: 57_000.0,
    inertia_extents: (3.0, 2.0, 6.3),
    // Continuous track (track architecture §7). link_count 97 = the marker-derived window's
    // lowest SPRING-limited count (window 96..97 at ride_frequency 1.2 Hz): full suspension
    // travel with the minimum slack that permits it — playtest-confirmed 2026-07-24. The real
    // Tiger ran 96/side (chain-limited, as a tensioned track is); revisit if belt-tension
    // forces ever land. Window recomputes when ride_frequency moves — recheck after retuning.
    // This block is authored VEHICLE DATA only — link count, link physicals, articulation limits,
    // the sprocket tooth count, and the suspension ride / powertrain models. All running-gear
    // GEOMETRY (pitch, plate thickness, shoe width, the track plane, and every sprocket/idler/wheel
    // circle) is MEASURED off the glb markers now — one source of truth, in the model — so nothing
    // geometric is authored here (see track::rig_geom / track::marker_model).
    track: (
        link_count: 97,
        link_mass: 30.0,
        hinge_torque: 45.0,
        // Hard articulation stops, in DEGREES (the `_deg` suffix is the unit contract; `spec.rs`
        // converts to radians once, at the deserialisation seam — nothing downstream sees
        // degrees). ASYMMETRIC because the shoe is: folding INWARD (toward the wheels) the guide
        // horns close on each other, folding OUTWARD (away from them) the ground-side structure
        // does. Two different features, two different numbers, both authored as POSITIVE
        // magnitudes named for their direction — a signed pair here is a sign convention waiting
        // to be read backwards.
        //   inward  40° — the WRAP direction: every wheel the belt bends around costs a fold this
        //           way (the tightest, the idler, demands 20.44°).
        //   outward 18° — a return run sagging, a shoe cresting a rock.
        // HAND-MEASURED in Blender, not derived. An automatic mesh sweep was built and rejected:
        // the shoe is modelled with near-zero clearance (~18 µm at the outward faces), so the
        // first-contact angle it reported moved with the penetration threshold (17.7° at 0.1 mm,
        // 42.9° at 0.5 mm, 46.0° at 2 mm) — an arbitrary number wearing a measurement's clothes.
        // And the mesh is only ever an UPPER BOUND anyway: real articulation is also limited by
        // pin/bushing clearance and the end connectors, none of which the shoe mesh models.
        link_angle: ( inward_deg: 40.0, outward_deg: 18.0 ),
        // 20 teeth (model-verified count) — the ONLY sprocket datum still authored. The pitch
        // radius is chord-exact from the MEASURED pitch × teeth (marker-derived, ~0.4155 m); the
        // sprocket centre and every other running-gear circle are measured off the glb too.
        // Reductions absorb the radius (speeds are anchored), so the tooth count is feel-neutral
        // for the transmission.
        sprocket: ( teeth: 20 ),
        // Phase-B locomotion: the SANDBOX force law scaled to the Tiger (the retired raycast
        // sim was a placeholder — nothing structural carries over). Stiff sandbox governor;
        // the contact-envelope law derives its spring/damper from `suspension` below (same
        // ~5 cm static sink at 57 t); inertia likewise. Hill-hold arrived with the grip regime
        // (ADR-0026); parking creep is gone.
        //
        // Force cap = the GRIP-LIMIT gearing rule (the T-34 lab benchmark: first gear can
        // just spin the tracks, cap ≈ μ·W/2 ≈ 252 kN here). The previous 100 kN was tuned
        // under the retired placeholder law for "climbs 20°, stalls 30°" and at 0.40× the
        // grip limit could not break a neutral steer (thrust moment 298 kN·m vs 478 kN·m of
        // footprint scrub — measured "Tiger unable to steer in place", 2026-07-18). At the
        // grip limit the pivot ratio is 1.56 (T-34 lab: 1.33) and the real Tiger could
        // neutral-steer. Consequence: steep climbs are now traction/power-limited, not
        // cap-limited — 30° crawls (~1.9 m/s power-limited) instead of stalling; the
        // traction stall moves to ~arctan μ ≈ 42°.
        powertrain: (
            max_speed: 10.5,
            power: 260_000.0,
            force: 250_000.0,
            governor_gain: 60_000.0,
            inertia: 16_000.0,
            // The DECLARED drivetrain (phase 2.5) — authored from the anchored tables in
            // .agents/docs/design/track-model/tiger-transmission-data.md. This declared
            // architecture SHIPS everywhere, MP included (REV 14 replicates the full
            // TransmissionState atomically; the governor knobs above remain shared belt-law
            // data, not a separate MP path).
            // Architecture: "wheel controlled hydraulic operated regenerative" [ANCHOR] — the
            // L600 fixed-radius adapter is the historically right one.
            transmission: (
                architecture: FixedRadii,
                engine: (
                    // HL230 P45. idle INFERRED (~600, typical for the engine class);
                    // governed 2500 = the fleet condition from Nov 1943 [ANCHOR]; per-gear
                    // speed anchors are quoted @ 3000 [ANCHOR].
                    idle_rpm: 600.0,
                    governed_rpm: 2500.0,
                    rated_rpm: 3000.0,
                    // V-12 [ANCHOR]. Four-stroke, so the crank fires 6 times per revolution:
                    // 60 Hz at idle, 250 Hz at the governor.
                    cylinders: 12,
                    // No `sound` block: the engine is silent until a loop worthy of the HL230
                    // exists (a `sound` is `(clip, clip_pop_hz)` — the pop rate MEASURED off the
                    // file at playback speed 1.0; `sfx` derives the rpm→playback-speed mapping
                    // from those two numbers and the rpm band above).
                    // (rpm, N·m): 800→1300 INFERRED (~0.70 × peak); 2100→1850 ANCHOR
                    // (medium); 2500→1686 DERIVED (600 PS); 3000→1639 DERIVED (700 PS).
                    torque_curve: [(800.0, 1300.0), (2100.0, 1850.0), (2500.0, 1686.0), (3000.0, 1639.0)],
                    // Compression braking at zero throttle: the MID-BAND anchor of
                    // the rising motoring-torque curve, as a fraction of peak torque.
                    // The sim's motoring torque equals drag_fraction × peak at
                    // ω_mid = (idle + governed)/2 = 1550 rpm and grows linearly with
                    // crank speed (1/3 base + 2/3 linear — pumping/friction losses
                    // rise with speed; ≈ 1.41× at governed, ≈ 1.62× at rated), so each
                    // gear has a bounded downhill equilibrium. Motoring runs ~20–30%
                    // of rated torque mid-band — INFERRED (no HL230 motoring curve
                    // reachable).
                    drag_fraction: 0.25,
                    // Crank + flywheel + main-clutch inertia J (kg·m²), the stage-B
                    // engine crank state. INFERRED by engine-class scaling (no HL230
                    // flywheel datum reachable): large multi-cylinder tank diesels/petrols
                    // land in a 2.5–6 kg·m² band, flywheel-dominant (a ~0.5 m, ~50–80 kg
                    // flywheel rim alone is 2–4 kg·m²; crank + clutch add the rest) —
                    // mid-band 4.0.
                    inertia_kgm2: 4.0,
                    // Main clutch torque capacity (N·m) ≈ 1.3 × the 1850 N·m peak —
                    // the usual dry-clutch sizing margin (INFERRED, no Argus/OLVAR clutch
                    // rating reachable). The stage-B coupling clamp: launch force and
                    // grade-lug drive are capacity-limited through the slipping clutch.
                    clutch_capacity_nm: 2400.0,
                ),
                gearbox: (
                    // OLVAR OG 40 12 16, 8F/4R [ANCHOR]. Per-gear top speeds @ 3000 rpm
                    // [ANCHOR — hamby / Jentz]; R1–R4 mirror F1–F4 [ANCHOR]. Reductions
                    // derive at build against the spec's own sprocket radius (the
                    // 19-vs-20-tooth discrepancy rule). F8 @ governed 2500 → 10.48 m/s,
                    // matching max_speed 10.5.
                    forward_speeds_kmh: [2.8, 4.3, 6.2, 9.2, 14.1, 20.9, 30.5, 45.4],
                    reverse_speeds_kmh: [2.8, 4.3, 6.2, 9.2],
                    // Auto-shift bands (INFERRED policy): up at 92% of governed; down at
                    // 1150 ≈ real OLVAR practice — hold the gear down to the low-torque
                    // knee, not the mid-band. Against the engine's usable envelope (idle
                    // 600, curve floor 800, peak torque @ 2100, governed 2500) a 1150 rpm
                    // landing still makes ~1450 N·m (~78% of peak): a landed gear pulls,
                    // and 1150 sits far clear of the idle-governor/lug region. The runtime
                    // landing gate demands `landing ≥ down band + 150 rpm` at the END of
                    // the torque-cut window (validated at load with the margin included):
                    // the widest ratio step (F1→F2, 0.651) lands 2300 × 0.651 ≈ 1498, so
                    // 1150 buys ~200 rpm of authored slack in EVERY gear. The previous
                    // 1400 band left the F1→F2 landing 52 rpm SHORT of its own gate — the
                    // box could never legally shift at the trigger rpm and only ever
                    // shifted by over-running the band to the governor.
                    shift_up_rpm: 2300.0,
                    shift_down_rpm: 1150.0,
                    // OLVAR preselector: pre-selected shifts complete with drive uncoupled
                    // for a noticeable fraction of a second — INFERRED ~0.31 s, no shift-
                    // time datum reached.
                    shift_secs: 0.31,
                    // OLVAR preselector capability [ANCHOR]: British Preliminary Report
                    // No. 19 and period operating instructions describe preselection of an
                    // arbitrary gear while any gear is engaged; one shift event therefore
                    // addresses the scheduler's target directly.
                    shift_addressing: Direct,
                ),
                steering: (
                    // (R_tight, R_wide) per forward gear (m): anchored at BOTH corners
                    // (3.44 m F1-tight, 165 m F8-wide), R ∝ 1/G within each step, tight:wide
                    // = 2.958 per gear [DERIVED — tiger-transmission-data.md table].
                    radii: [
                        (3.44,  10.2),
                        (5.28,  15.6),
                        (7.62,  22.5),
                        (11.30, 33.4),
                        (17.32, 51.2),
                        (25.68, 76.0),
                        (37.47, 110.8),
                        (55.78, 165.0),
                    ],
                    // Steering-member force capacity PER OUTPUT (N): the grip-limit
                    // gearing rule's per-track datum (≈ μ·W/2, same as `force`). The
                    // member drives the two outputs DIFFERENTIALLY, so the belt-difference
                    // axis F_s is bounded by 2× this: 500 kN → 745 kN·m of yaw moment
                    // against the ~478 kN·m footprint scrub — breakaway ratio 1.56, the
                    // mirror of the force-cap fix above (T-34 lab: 1.33). Reading this
                    // datum as the F_s bound itself gave 373 kN·m < scrub — the measured
                    // "Tiger unable to steer in place" (2026-07-18). INFERRED sizing, no
                    // published steering-member torque rating reachable.
                    capacity: 250_000.0,
                    // `neutral_fraction` DELETED (fix 3, 2026-07-19): the 0.75 was an
                    // INFERRED feel scalar with no source. The marginal brake-gated
                    // neutral turn now uses the DERIVED datum directly:
                    // neutral_d_full = κ_tight(F1) × v1_governed = 0.2885 m/s (with the
                    // marker-measured half_tread 1.5312) — the radii table's own invariant
                    // (κ_tight(g) × v(g) ≈ 0.346 m/s @ 3000 rpm in EVERY gear) makes that
                    // the correct emergent value for a fixed-radius box.
                    // Mechanical recirculation efficiency ~0.9 — INFERRED.
                    recirculation: 0.9,
                ),
                // Per-side brake capacity at the sprocket, DUAL-anchored (fix-4 +
                // review round):
                //   (1) the settled 20° park-hold capability (ADR-0026 records 20°
                //       holds; the test course has 20° ramps): W·sin 20°/2 =
                //       57 000 × 9.81 × 0.342 / 2 ≈ 95.6 kN/side — 96 kN holds it
                //       with margin;
                //   (2) 192 kN total = 0.343 g service decel — inside the 0.2–0.35 g
                //       historical band for WWII heavy tanks (even modern heavy trucks
                //       certify ~0.5 g).
                // Replaces the circular grip-limit sizing (250 kN was sized against
                // μ·W/2 — the very friction it was meant to be tested by — and implied
                // 2.9 MW through two 1940s Argus discs at speed: energy-impossible).
                // The dynamic datum still governs every moving slide and service-brake stop;
                // static breakaway is authored separately below.
                brake_force: 96_000.0,
                // INFERRED provisional — static breakaway vs dynamic dissipation are different
                // physical limits (static hold does no work; sourced material ratios span
                // 1.05–2.0×). The Tiger's Argus discs are documented as self-energizing in both
                // British Report No. 19 and D 656/30, but no numerical Argus rating
                // survives; supersede when sourced. At 1.5×, the DERIVED static capacity is
                // 2 × 96,000 × 1.5 = 288,000 N total against the DERIVED 30° demand
                // 57,000 × 9.81 × sin(30°) = 279,585 N: an 8,415 N DERIVED margin.
                brake_static_factor: 1.5,
            ),
        ),
        // The ride model — everything else derives: spring rate m·(2πf)², static deflection
        // g/(2πf)² ≈ 0.173 m (the droop envelope depth, chain-clamped by the link window),
        // damper 2ζ√(k·m). Real tanks ride at ~1–1.5 Hz.
        suspension: (
            ride_frequency: 1.2, // Hz
            damping_ratio: 0.35,
            // Compression travel above rest (m) — the red hard stop. Tuned in the sandbox
            // 2026-07-24: raised until the compression wrap clears the hull; note the belly
            // hand-off — past ~0.10 m the unsprung idler/sprocket own the red belly, so the
            // extra travel here mostly widens the per-wheel stop, not the collider floor.
            bump_stop: 0.200,
            // Contact engage-ramp depth (m): the penetration over which a contact ramps from
            // zero to full support — the anti-pop smoothing of the contact law.
            engage: 0.02,
        ),
    ),
    servos: {
        "Turret_Yaw":      (role: Yaw,   max_speed: 34.0, accel: 70.0, travel: Continuous,                      requires: [Gunner]),
        "Main_Gun_Pitch":  (role: Pitch, max_speed: 23.0, accel: 70.0, travel: Limited(min: -8.0,  max: 15.0),  requires: [Gunner]),
        "Hull_MG_Yaw":     (role: Yaw,   max_speed: 45.0, accel: 90.0, travel: Limited(min: -30.0, max: 30.0),  requires: [BowGunner]),
        "Hull_MG_Pitch":   (role: Pitch, max_speed: 45.0, accel: 90.0, travel: Limited(min: -10.0, max: 20.0),  requires: [BowGunner]),
    },
    // COMPONENTS — behaviour only (design §12, classifier precedent 2026-08-07).
    //
    // This map no longer decides WHICH nodes the shell marches through: membership is the MATERIAL,
    // per primitive. A mesh is a ballistic volume iff it wears one of the substances in
    // assets/materials/materials.ron (RHA / Cast / GunSteel / MildSteel / EngineBlock / Ammunition /
    // Rubber / Flesh), linked in from assets/materials/materials.blend. Resistance comes from that
    // one registry, keyed by the substance name — per-node `material_factor` is GONE, and with it
    // the possibility of a plate and its own material disagreeing.
    //
    // So this map holds ONLY the nodes that are more than armour: an hp pool, and the consequence
    // facets layered on it (crew / ammo / function). Every pure armour plate — the whole hull and
    // turret, the mantlet, the MG bodies, the road wheels — is absent BY DESIGN. Both directions
    // fail loud at bind: a key here that is not a ballistic volume is an error, and the
    // material-implied lints catch the reverse (Flesh with no crew facet, Ammunition with no ammo
    // facet, EngineBlock with no entry).
    volumes: {
        // --- Modules (hp = integrity; the substance carries resistance, independently) ---
        "Engine":           (hp: 10.0, function: Engine),
        "Transmission":     (hp: 10.0, function: Transmission),
        "Breech":           (hp:  8.0, function: Breech),
        "Main_Gun_Barrel":  (hp:  8.0, function: GunBarrel),
        // --- Crew ---
        "Commander":        (hp: 3.0, crew: Commander),
        "Gunner":           (hp: 3.0, crew: Gunner),
        "Loader":           (hp: 3.0, crew: Loader),
        "Driver":           (hp: 3.0, crew: Driver),
        "BowGunner":        (hp: 3.0, crew: BowGunner),
        // --- Ammunition (ammo: true means cookoff when dead) ---
        "Ammo_L_0":         (hp: 2.0, ammo: true),
        "Ammo_L_1":         (hp: 2.0, ammo: true),
        "Ammo_R_0":         (hp: 2.0, ammo: true),
        "Ammo_R_1":         (hp: 2.0, ammo: true),
        // --- Smoke launchers: damageable, deliberately INERT. They carry an hp pool so the round
        // that shears one off is recorded, and no `function`, because nothing fires them yet. The
        // facet is the seam the smoke-discharger work binds to; until then losing one costs the
        // vehicle nothing. 2.0 hp = the ammo pool's value: a thin external fitting, not structure.
        "Smoke_Launcher_0": (hp: 2.0),
        "Smoke_Launcher_1": (hp: 2.0),
        "Smoke_Launcher_2": (hp: 2.0),
        "Smoke_Launcher_3": (hp: 2.0),
        "Smoke_Launcher_4": (hp: 2.0),
        "Smoke_Launcher_5": (hp: 2.0),
    },
    // Collision proxies (convex hull, Vehicle layer) — DECLARED, replacing the `*_Collider` suffix
    // scan. The suffix survives as a name because it reads well in Blender; nothing parses it.
    colliders: ["Hull_Collider", "Turret_Collider"],
    // Roadwheel stations — DECLARED, replacing the `Wheel_{L,R}_{n}` pattern match. The SAME node is
    // the suspension station and its own armour volume: each wheel is one object holding five closed
    // shells — two MildSteel bodies, two Rubber rims, one axle — so the wheel needs no volume
    // declaration (its materials are the declaration) but it does need its station role and side
    // stated. ORDER IS LOAD-BEARING: this is the `WheelIndex` slot order both wire ends derive.
    roadwheels: [
        (node: "Wheel_L_0", side: Left),
        (node: "Wheel_L_1", side: Left),
        (node: "Wheel_L_2", side: Left),
        (node: "Wheel_L_3", side: Left),
        (node: "Wheel_L_4", side: Left),
        (node: "Wheel_L_5", side: Left),
        (node: "Wheel_L_6", side: Left),
        (node: "Wheel_L_7", side: Left),
        (node: "Wheel_R_0", side: Right),
        (node: "Wheel_R_1", side: Right),
        (node: "Wheel_R_2", side: Right),
        (node: "Wheel_R_3", side: Right),
        (node: "Wheel_R_4", side: Right),
        (node: "Wheel_R_5", side: Right),
        (node: "Wheel_R_6", side: Right),
        (node: "Wheel_R_7", side: Right),
    ],
    weapons: {
        // fire_mode is the mechanism: the 88 is Single (one round per click, crew-gated reload —
        // and no belt fields to author); the 7.9 mm MGs are Automatic (held trigger, 750 rpm =
        // the 0.08 s cyclic interval, a 150-round belt drum over an infinite reserve, ~3.5 s
        // crew-gated belt swap when dry, one-in-five tracer belt).
        "MainGun": (
            trigger: Primary,
            muzzle: "Main_Gun_Muzzle",
            barrel: "Main_Gun_Recoil",
            speed: 773.0, caliber: 0.088, mass: 10.2,
            fire_mode: Single(reload_secs: 3.0),
            recoil: (kick: 14.0, stiffness: 90.0, damping: 14.0),
            fire: [Gunner, Breech, GunBarrel],
            load: [Loader, Breech],
            // Five takes of the 88's report, one rolled per round (never the same take twice in
            // a row). The list is the weapon's sound: adding a take is a line here, and a weapon
            // with no takes is silent.
            report_clips: [
                "sfx/explosion/88_cannon_1.ogg",
                "sfx/explosion/88_cannon_2.ogg",
                "sfx/explosion/88_cannon_3.ogg",
                "sfx/explosion/88_cannon_4.ogg",
                "sfx/explosion/88_cannon_5.ogg",
            ],
        ),
        "Coax": (
            trigger: Secondary,
            muzzle: "Coax_MG_Muzzle",
            barrel: "Coax_MG_Recoil",
            speed: 755.0, caliber: 0.0079, mass: 0.0118,
            fire_mode: Automatic(rpm: 750.0, belt_size: 150, belt_swap_secs: 3.5, tracer_every: 5),
            recoil: (kick: 3.0, stiffness: 240.0, damping: 18.0),
            fire: [Backup([(1.0, [Gunner]), (1.0, [Loader])])],
            load: [Backup([(1.0, [Gunner]), (1.0, [Loader])])],
            // No MG recording in the library yet — silent until one is cut and listed here.
            report_clips: [],
        ),
        "HullMG": (
            trigger: Secondary,
            muzzle: "Hull_MG_Muzzle",
            barrel: "Hull_MG_Recoil",
            speed: 755.0, caliber: 0.0079, mass: 0.0118,
            fire_mode: Automatic(rpm: 750.0, belt_size: 150, belt_swap_secs: 3.5, tracer_every: 5),
            recoil: (kick: 3.0, stiffness: 240.0, damping: 18.0),
            fire: [BowGunner],
            // Same rule as the coax: the swap needs the gun's crew.
            load: [BowGunner],
            report_clips: [],
        ),
    },
    views: {
        // The gunner's sight is the TZF 9b: 2.5× over a 25° true field, both MEASURED off the
        // instrument's data sheet. The commander looks through a hatch, so his view has no
        // magnification to state and authors the field alone. `requires` gates the view — a dead
        // crewman blacks it out.
        Gunner:    (node: "Main_Gun_Pitch", optics: Magnified(magnification: 2.5, field_deg: 25.0), requires: [Gunner]),
        Commander: (node: "Turret_Yaw",     optics: Unaided(45.0), requires: [Commander]),
    },
    capabilities: {
        Drive: [Driver, Engine, Transmission],
    },
)
