    ],
    weapons: {
        // Each mount names its gun (assets/guns/), whose ammunition table gives every stowed round
        // its muzzle speed and whose mechanism the mount's fire_mode shares: the 88 is Single (one
        // round per click, crew-gated reload, no belt to author); the 7.9 mm MGs are Automatic
        // (held trigger at the gun's cyclic rate, a 150-round belt drum over an infinite reserve,
        // ~3.5 s crew-gated belt swap when dry, a one-in-five tracer belt). The gun carries the
        // report.
        "MainGun": (
            trigger: Primary,
            muzzle: "Main_Gun_Muzzle",
            bore_length: (4.1488614, Derived("DERIVED from the battery muzzle-to-Main_Gun_Pitch
                bore projection in tiger_1.sim.glb; ASSUMED that this pivot locates the bore start.
                The start moves with barrel recoil; replace this construction assumption with a
                measured breech-to-muzzle distance when available")),
            barrel: "Main_Gun_Recoil",
            gun: "kwk36_l56",
            // The rounds it carries and how many: keys in assets/rounds/, each one's speed the
            // gun's. The first is the round it spawns loaded with; the crew selects among them,
            // and a selection takes effect at the next load. The counts are read by nothing yet
            // (the reserve is infinite).
            stowage: [
                // The 92-round load in the 1943 North Africa mix, most carried first: M.I.10
                // A/M564 via Brit43 pp.91-92 gives 66 % APCBC, 25 % HE and 9 % AP 40, and Brit43's
                // own arithmetic 61, 23 and 8 of 92. Fixture data, read by nothing yet.
                (round: "88mm_APHE_ring", count: (61, Measured("CITED Brit43 pp.91-92: 61 APCBC of
                    92, 66 %"))),
                (round: "88mm_HE", count: (23, Measured("CITED Brit43 pp.91-92: 23 HE of 92,
                    25 %"))),
                (round: "88mm_APCR", count: (8, Measured("CITED Brit43 pp.91-92: 8 AP 40 of 92,
                    9 %"))),
            ],
            fire_mode: Single(reload_secs: 3.0),
            // max_length is the recoil stop: the farthest the barrel travels back from battery, m.
            // The spring's own peak from one shot is 0.53 m (DERIVED, the 64 Hz fixed-step
            // integration of this kick, stiffness and damping), so a single shot never reaches it.
            recoil: (kick: 14.0, stiffness: 90.0, damping: 14.0, max_length: (0.58,
                Unknown("ASSUMED 580 mm, the KwK 36 recoil length a secondary source gives
                (historyrise.com, 'the technical breakdown of the Tiger's 88mm gun system'); no
                gun handbook states it in the repo; settled by a cited handbook figure"))),
            fire: [Gunner, Breech, GunBarrel],
            load: [Loader, Breech],
        ),
        "Coax": (
            trigger: Secondary,
            muzzle: "Coax_MG_Muzzle",
            bore_length: (0.4525745, Derived("DERIVED from the battery muzzle-to-Main_Gun_Pitch
                bore projection in tiger_1.sim.glb; ASSUMED that this pivot locates the bore start.
                The start moves with barrel recoil; replace this construction assumption with a
                measured breech-to-muzzle distance when available")),
            barrel: "Coax_MG_Recoil",
            gun: "mg34",
            stowage: [
                (round: "7.9mm_AP", count: (2400, Unknown("half the commonly reported 4,800-round
                    7.92 mm load (32 belt bags of 150) shared by the two machine guns; no stowage
                    table in the repo; settled by a cited stowage table"))),
            ],
            fire_mode: Automatic(belt_size: 150, belt_swap_secs: 3.5),
            tracer_every: 5,
            // The stop bounds the spring's peak in sustained fire at the gun's cyclic rate, 0.113 m
            // (DERIVED, 64 Hz fixed-step integration, a kick every 6 ticks), so it holds the barrel
            // only past that rate.
            recoil: (kick: 3.0, stiffness: 240.0, damping: 18.0, max_length: (0.12,
                Unknown("ASSUMED: no handbook figure for the MG 34's barrel travel in the repo;
                0.12 m clears the spring's peak at the cyclic rate; settled by a cited handbook
                figure"))),
            fire: [Backup([(1.0, [Gunner]), (1.0, [Loader])]), CoaxMgBarrel],
            load: [Backup([(1.0, [Gunner]), (1.0, [Loader])])],
        ),
        "HullMG": (
            trigger: Secondary,
            muzzle: "Hull_MG_Muzzle",
            bore_length: (0.22281814, Derived("DERIVED from the battery muzzle-to-Hull_MG_Pitch
                bore projection in tiger_1.sim.glb; ASSUMED that this pivot locates the bore start.
                The start moves with barrel recoil; replace this construction assumption with a
                measured breech-to-muzzle distance when available")),
            barrel: "Hull_MG_Recoil",
            gun: "mg34",
            stowage: [
                (round: "7.9mm_AP", count: (2400, Unknown("half the commonly reported 4,800-round
                    7.92 mm load (32 belt bags of 150) shared by the two machine guns; no stowage
                    table in the repo; settled by a cited stowage table"))),
            ],
            fire_mode: Automatic(belt_size: 150, belt_swap_secs: 3.5),
            tracer_every: 5,
            // The stop as the coax's: the same gun and spring.
            recoil: (kick: 3.0, stiffness: 240.0, damping: 18.0, max_length: (0.12,
                Unknown("ASSUMED: no handbook figure for the MG 34's barrel travel in the repo;
                0.12 m clears the spring's peak at the cyclic rate; settled by a cited handbook
                figure"))),
            fire: [BowGunner, BowMgBarrel],
            // Same rule as the coax: the swap needs the gun's crew.
            load: [BowGunner],
        ),
    },
    views: {
        // The gunner's sight is the TZF 9b: 2.5× over a 25° true field, both MEASURED off the
        // instrument's data sheet. The commander looks through a hatch, so his view has no
        // magnification to state and authors the field alone. `requires` gates the view — a
        // knocked-out crewman blacks it out.
        Gunner:    (node: "Main_Gun_Pitch", optics: Magnified(magnification: 2.5, field_deg: 25.0), requires: [Gunner]),
        Commander: (node: "Turret_Yaw",     optics: Unaided(45.0), requires: [Commander]),
    },
    drive_controls: Any([[Driver]]),
    capabilities: {
        Drive: [Driver, Engine, Transmission],
    },
)
