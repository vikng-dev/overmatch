// The wood data of the game's environment destruction and damage model, game state only.
// Read by `src/trees.rs` with species.ron before play: the trunk's substance and HP pools, shared
// by every species, and per species (`structure`) the facts a trunk is built from as a structure
// (`crate::trees::TreeBody::structure`): its segments chunks of one wood, joined by the wood's
// own along-grain seam, the trunk held to the ground by its species' root plate. The wall design
// (`.agents/docs/design/wall-destruction.md`, "Trees are structures by the same laws") owns the
// model narrative.
//
// `structure.<species>.along_grain_rupture_pa` (Pa): green-wood bending modulus of rupture,
// longitudinal extreme-fibre stress: the tensile strength of the trunk's seam between two
// segments, which the section strength law compares with the bending stress there. It is
// distinct from the perpendicular-to-grain timber seam in materials.ron, which building joints
// read.
// `along_grain_fracture_j_per_m2` (J/m²): mode-I opening work for tension ALONG the fibres,
// across a trunk section (LR/LT fracture systems): the seam's fracture energy, which the blow law
// spends per separated section area. It is NOT splitting along the fibres (RL/TL), whose stress
// is across the grain. The saturated softwood analogue is explicitly ASSUMED for every shipped
// species; no matched green longitudinal-fracture measurements were found. It must not be called
// a measured tree material property. The cited FHWA table itself models its parallel values from
// correlations.
// `fresh_density_kg_per_m3` (kg/m³): the green wood's density, its water in it, the mass a
// segment's volume holds (its weight in the strength law) and the FRESH STEM MASS a root plate's
// coefficient multiplies. The substance's density in materials.ron is dry timber's and never
// stands in for it.
// `anchor`: the root plate the trunk holds to the ground by, a `RootPlate` kind of
// `assets/materials/attachments.ron`, whose row carries its numbers, sources and soil.
//
// `substance` is the trunk's substance, a hard key of `assets/materials/materials.ron` that
// states bulk facts (its chunks' material in the structure laws).
// `hp_per_m2` is a trunk segment's HP pool per square metre of its cross-section at mid-height
// (the instance's, scale applied): a segment whose two end radii average r has
// `round(hp_per_m2 × π r²)` HP points, at least one. Each segment's pool takes the energy a round
// loses crossing that segment at the one energy-to-HP rate every hard pool shares
// (`assets/ballistics/energy_dose.ron`); a pool emptied opens the seam at its segment's base, so
// the trunk breaks there by the same structural state a body's contact breaks it by.
//
// PROVENANCE: every number is authored `(value, Kind("source or reason"))`, Kind one of Measured,
// Derived, Tuned, Resolution, Unknown (`src/provenance.rs`); a value without one does not load. The
// loader refuses a non-positive one.
Wood(
    substance: "Wood",
    hp_per_m2: (1500.0, Tuned("provisional (issue 149), a round number calibrated loosely: the
        shipped fir's (fir_1) base segment, 0.405 m across at mid-height, holds 193 HP (DERIVED),
        so the 88 mm APCBC's centred hit there (156 HP, MEASURED) empties it at the second shot;
        shots to break every cell MEASURED in
        .agents/scratch/damage-model-2026-10-29/segment-pools-results.md")),
    structure: {
        "norway_spruce": StructuralWood(
            along_grain_rupture_pa: (36.0e6, Measured("MEASURED transcription: Merlin et al.,
                Large-scale modelling wind damage vulnerability (2025), Table 2, default Norway
                spruce MOR 36 MPa (green-wood ForestGALES parameter, not a fresh tree measurement).
                https://www.plantedforests.org/wp-content/uploads/2025/05/FECOS-D-25-00237_R1paper_only.pdf
                The table misprints its MOR unit; MPa follows the model definition, not kN/mm2.")),
            along_grain_fracture_j_per_m2: (22340.0, Tuned("ASSUMED saturated clear-softwood
                analogue, not measured Norway spruce: Murray, FHWA-HRT-04-097 (2007), section
                1.7.3, Table 10, saturated parallel mode I 2.234 MPa cm = 22340 J/m2 (DERIVED unit
                conversion). Source uses correlated model values for southern yellow pine and
                Douglas fir, no measured parallel-mode data. Species and living-trunk transfer
                are unverified. https://www.fhwa.dot.gov/publications/research/safety/04097/04097.pdf")),
            fresh_density_kg_per_m3: (850.0, Measured("MEASURED transcription: ForestGALES fgr
                package species parameters (tom-locatelli/fgr, data/ud_species_parameters.rda,
                read 2026-11-01), row NS,
                stem_density 850 kg/m3: the green wood density the model multiplies stem
                volume by for the fresh stem mass its overturning coefficients read (fgr
                manual 16092020). The same table states NS mor 3.6e7 Pa, matching
                along_grain_rupture_pa. A model parameter, not a measurement of these trees")),
            anchor: "norway_spruce_root_plate",
        ),
        "scots_pine": StructuralWood(
            along_grain_rupture_pa: (46.0e6, Measured("MEASURED transcription: Merlin et al.
                (2025), Table 2, default Scots pine MOR 46 MPa, the green-wood ForestGALES
                parameter. Same source and MOR unit correction as norway_spruce above.")),
            along_grain_fracture_j_per_m2: (22340.0, Tuned("ASSUMED saturated clear-softwood
                analogue, not measured Scots pine: Murray, FHWA-HRT-04-097 (2007), section 1.7.3,
                Table 10, saturated parallel mode I 2.234 MPa cm = 22340 J/m2 (DERIVED conversion).
                Correlated model values for southern yellow pine and Douglas fir; species and
                living-trunk transfer unverified. Same FHWA source as norway_spruce above.")),
            fresh_density_kg_per_m3: (850.0, Measured("MEASURED transcription: fgr species
                parameters, row SP, stem_density 850 kg/m3, green wood density (same source as norway_spruce above; the same
                table states SP mor 4.6e7 Pa). A model parameter, not a measurement of these
                trees")),
            anchor: "scots_pine_root_plate",
        ),
        "silver_birch": StructuralWood(
            along_grain_rupture_pa: (63.0e6, Tuned("ASSUMED species transfer of the MEASURED
                transcription in Merlin et al. (2025), Table 2: default birch MOR 63 MPa, the
                green-wood ForestGALES parameter. Table says birch, not specifically Betula
                pendula; treating it as silver birch is an analogue. Same source and MOR unit
                correction as norway_spruce above.")),
            along_grain_fracture_j_per_m2: (22340.0, Tuned("ASSUMED saturated clear-softwood
                analogue for hardwood, not measured silver birch: Murray, FHWA-HRT-04-097 (2007),
                section 1.7.3, Table 10, saturated parallel mode I 2.234 MPa cm = 22340 J/m2
                (DERIVED conversion). Correlated southern yellow pine/Douglas fir model value;
                neither species nor living-trunk transfer is verified. No suitable birch
                longitudinal-opening measurement found. Same FHWA source as norway_spruce above.")),
            fresh_density_kg_per_m3: (900.0, Tuned("ASSUMED species transfer of the MEASURED
                transcription in the fgr species parameters, row BI (birch, not specifically Betula pendula),
                stem_density 900 kg/m3, green wood density (same source as norway_spruce
                above; the same table states BI mor 6.3e7 Pa)")),
            anchor: "silver_birch_root_plate",
        ),
    },
)
