// Shared player keyboard feel; no vehicle-specific parameters.
(
    tap_window_s: (0.15, Taste("keyboard feel: duration separating a persistent notch tap from a full-axis hold")),
    notch_count: (3, Taste("keyboard feel: equal throttle notches from neutral to full on each side")),
    wide_on: (0.15, Taste("steering feel: wide detent engages near the start of steering pedal travel")),
    tight_on: (0.8, Taste("steering feel: tight detent engages near the end of steering pedal travel")),
    rise_per_second: (4.0, Taste("keyboard feel: pedal travel per second for notch changes, holds and release")),
)
