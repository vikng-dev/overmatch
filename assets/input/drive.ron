// Shared player keyboard feel; no vehicle-specific parameters.
(
    tap_window_s: (0.15, Taste("keyboard feel: duration separating a persistent notch tap from a full-axis hold")),
    notch_step: (0.25, Taste("keyboard feel: signed lever increment for each short press")),
    wide_on: (0.15, Taste("steering feel: wide detent engages between neutral and the first notch")),
    wide_off: (0.05, Taste("steering feel: wide detent releases below the first notch")),
    tight_on: (0.65, Taste("steering feel: tight detent engages between the second and third notches")),
    tight_off: (0.55, Taste("steering feel: tight detent releases between the second and third notches")),
    rise_per_second: (4.0, Taste("keyboard feel: pedal travel per second for notch changes, holds and release")),
)
