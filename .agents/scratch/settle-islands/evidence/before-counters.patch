+// [DEBUG-settle] Observations of the game's environment destruction, not assertions on outputs.
+#[test]
+#[ignore]
+fn diag_settle_pile() {
+    let kind=std::env::var("SETTLE_KIND").unwrap();
+    let seconds=std::env::var("SETTLE_SECONDS").unwrap().parse::<u32>().unwrap();
+    let (mut app, root)=composed(false);
+    app.insert_resource(Gravity(Vec3::NEG_Y * 9.81));
+    app.world_mut().spawn((RigidBody::Static, Position(Vec3::new(0.0,-0.5,0.0)),Collider::cuboid(200.0,1.0,200.0),CollisionLayers::new([Layer::Terrain],LayerMask::ALL)));
+    if kind != "native" {
+        app.world_mut().entity_mut(root).despawn();
+        crate::net::debris_stress::diag_fixture(app.world_mut(),kind.parse().unwrap());
+    }
+    for tick in 0..64*seconds {
+        if kind == "native" && [64,384,704,1024].contains(&tick) {
+            let i=[64,384,704,1024].iter().position(|t|*t==tick).unwrap();
+            let offset=[Vec3::new(3.0,0.5,0.0),Vec3::new(-3.0,0.5,0.0),Vec3::new(0.0,0.5,4.0),Vec3::new(0.0,0.5,-4.0)][i];
+            set_off(&mut app,offset,Blast::of(16e6,0.1,1e-6));
+        }
+        app.update();
+        if tick%64==63 {
+            let mut snapshot=diag_settle_snapshot(app.world_mut());
+            snapshot["simulation_s"]=((tick+1)/64).into();
+            snapshot["kind"]=kind.clone().into();
+            println!("[DEBUG-settle] {snapshot}");
+        }
+    }
+}
