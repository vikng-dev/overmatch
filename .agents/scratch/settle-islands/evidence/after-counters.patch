+        .iter(world).map(|(e,l,a,t,h,i,s)| serde_json::json!({"entity":format!("{e:?}"),"v":l.length(),"w":a.length(),"timer":t.0,"mature":t.0 >= world.resource::<TimeToSleep>().0,"over_threshold":l.length() >= h.linear || a.length() >= h.angular,"island":i.island_id().0,"sleeping":s})).collect();
+    let asleep = bodies.iter().filter(|b| b["sleeping"] == true).count();
+    serde_json::json!({"awake":bodies.len()-asleep,"asleep":asleep,"over_threshold":bodies.iter().filter(|b|b["over_threshold"] == true && b["sleeping"] == false).count(),"mature":bodies.iter().filter(|b|b["mature"] == true && b["sleeping"] == false).count(),"contact_requests":avian3d::diag_settle::CONTACT.swap(0,Relaxed),"wake_requests":avian3d::diag_settle::WAKES.swap(0,Relaxed),"timer_resets":avian3d::diag_settle::RESETS.swap(0,Relaxed),"awake_timer_resets":avian3d::diag_settle::AWAKE_RESETS.swap(0,Relaxed),"bodies":bodies})
+}
+pub(crate) fn diag_settle_server(world: &mut World, mut last: bevy::ecs::system::Local<Option<std::time::Instant>>, mut began: bevy::ecs::system::Local<Option<std::time::Instant>>) {
+    let now=std::time::Instant::now();
+    let start=*began.get_or_insert(now);
+    let previous=last.get_or_insert(now);
+    if now.duration_since(*previous).as_secs_f64()<1.0 {return;}
+    *previous=now;
+    let mut snapshot=diag_settle_snapshot(world);
+    snapshot["wall_s"]=now.duration_since(start).as_secs_f64().into();
+    println!("[DEBUG-settle] {snapshot}");
+}
