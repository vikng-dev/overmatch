@@ -3186,0 +3245,31 @@ mod tests {
+
+#[cfg(test)]
+mod resolution_tests {
+    use super::*;
+    /// Contact slabs require the full physical width; linear pressure requires its first two
+    /// lateral moments. Moving the Gauss nodes to the edges or shrinking bounds breaks this.
+    #[test]
+    fn quadrature_preserves_shoe_bounds_and_linear_pressure_moments() {
+        // Fixture: biased shoe interval and linear lateral pressure.
+        let (lo, hi, a, b) = (-0.3_f32, 0.5_f32, 2.0_f32, 0.5_f32);
+        let center = (lo + hi) / 2.0;
+        for points in [2, 3] {
+            let columns = LateralColumns::for_shoe(
+                [(lo, 1.0 / 6.0), (center, 2.0 / 3.0), (hi, 1.0 / 6.0)],
+                points,
+            );
+            assert_eq!(columns.bounds(), (lo, hi));
+            let force: f32 = columns.samples().iter().map(|(x, w)| w * (a + b * x)).sum();
+            let moment: f32 = columns
+                .samples()
+                .iter()
+                .map(|(x, w)| w * x * (a + b * x))
+                .sum();
+            assert!((force - (a + b * center)).abs() < 1e-6);
+            assert!(
+                (moment - (a * center + b * (center * center + (hi - lo).powi(2) / 12.0))).abs()
+                    < 1e-6
+            );
+        }
+    }
+}
diff --git a/src/track/lean_observations.rs b/src/track/lean_observations.rs
index 0c210bc2..3d478867 100644
--- a/src/track/lean_observations.rs
+++ b/src/track/lean_observations.rs
@@ -77,0 +78,62 @@ fn terrain_resolution_observations() {
+
+/// Work observations at each requested resolution, with the shipped plugin and an empty flat
+/// fixture world. No output is a requirement; counts expose the cost of each quadrature.
+#[test]
+#[ignore = "resolution work matrix, run on demand"]
+fn resolution_work_matrix() {
+    use crate::track::forces::ContactResolution;
+    for stations in [97, 48, 24, 16] {
+        // Fixture: the requested experiment settings.
+        for lateral_points in [3, 2] {
+            let grid = HeightGrid::new(
+                vec![0.0; 4].into(),
+                2,
+                TerrainExtent {
+                    world_size_m: 64.0,
+                    height_offset_m: 0.0,
+                    height_span_m: 1.0,
+                },
+            );
+            let mut app = booted_driving_grid(grid);
+            crate::track::sim::set_test_resolution(
+                &mut app,
+                ContactResolution {
+                    stations,
+                    lateral_points,
+                },
+            );
+            app.init_resource::<crate::cost::stages::Stages>();
+            start_fixed_clock(&mut app);
+            let tank = app
+                .world_mut()
+                .query_filtered::<Entity, (With<crate::tank::Tank>, With<crate::tank::Controlled>)>(
+                )
+                .single(app.world())
+                .unwrap();
+            let mut lo = f64::INFINITY;
+            let mut hi = 0.0_f64;
+            for _ in 0..128 {
+                // Fixture: settle then sample a short straight drive.
+                app.world()
+                    .resource::<crate::cost::stages::Stages>()
+                    .take_counts();
+                drive_tick(&mut app, tank, 1.0, 0.0);
+                let work = serde_json::to_value(
+                    app.world()
+                        .resource::<crate::cost::stages::Stages>()
+                        .take_counts(),
+                )
+                .unwrap();
+                let samples = work["belt_terrain_samples"].as_f64().unwrap() / 2.0;
+                lo = lo.min(samples);
+                hi = hi.max(samples);
+            }
+            let contacts = app.world().get::<TrackContacts>(tank).unwrap();
+            println!(
+                "MEASURED resolution {stations}x{lateral_points}: terrain_samples_per_tank={lo}..{hi} contacts={} pose={:?}",
+                contacts.0.iter().map(Vec::len).sum::<usize>(),
+                app.world().get::<Position>(tank).unwrap().0
+            );
+        }
+    }
+}
