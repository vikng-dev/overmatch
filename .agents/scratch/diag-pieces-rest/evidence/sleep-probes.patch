+// [DEBUG-rest] Throwaway diagnostic of the game's environment destruction: same pile before
+// and after an intervention. Observations, not an emergent-output regression test.
+#[derive(Resource)]
+struct DiagPhase {
+    start: std::time::Instant,
+    us: f64,
+}
+fn diag_open(mut phase: ResMut<DiagPhase>) {
+    phase.start = std::time::Instant::now();
+}
+fn diag_close(mut phase: ResMut<DiagPhase>) {
+    phase.us = phase.start.elapsed().as_secs_f64() * 1e6;
+}
+
+#[test]
+fn diag_pieces_rest() {
+    use avian3d::dynamics::solver::islands::{BodyIslandNode, PhysicsIslands};
+    use std::sync::atomic::Ordering::Relaxed;
+    let kind = std::env::var("DIAG_KIND").unwrap_or("native".into());
+    let action = std::env::var("DIAG_ACTION").unwrap_or("force".into());
+    let (mut app, root) = composed(false);
+    app.insert_resource(Gravity(Vec3::NEG_Y * 9.81));
+    app.insert_resource(DiagPhase {
+        start: std::time::Instant::now(),
+        us: 0.0,
+    });
+    app.add_systems(
+        PhysicsSchedule,
+        (
+            diag_open.in_set(PhysicsStepSystems::First),
+            diag_close.in_set(PhysicsStepSystems::Last),
+        ),
+    );
+    app.world_mut().spawn((
+        RigidBody::Static,
+        Position(Vec3::new(0.0, -0.5, 0.0)),
+        Collider::cuboid(200.0, 1.0, 200.0),
+        CollisionLayers::new([Layer::Terrain], LayerMask::ALL),
+    ));
+    if kind != "native" {
+        app.world_mut().entity_mut(root).despawn();
+        crate::net::debris_stress::diag_fixture(app.world_mut(), kind.parse().unwrap());
+    }
+    let mut tick_us = Vec::new();
+    let mut physics_us = Vec::new();
+    let wall = std::time::Instant::now();
+    for tick in 0..(64 * 100) {
+        if kind == "native" && [64, 384, 704, 1024].contains(&tick) {
+            let i = [64, 384, 704, 1024]
+                .iter()
+                .position(|t| *t == tick)
+                .unwrap();
+            let offset = [
+                Vec3::new(3.0, 0.5, 0.0),
+                Vec3::new(-3.0, 0.5, 0.0),
+                Vec3::new(0.0, 0.5, 4.0),
+                Vec3::new(0.0, 0.5, -4.0),
+            ][i];
+            set_off(&mut app, offset, Blast::of(16e6, 0.1, 1e-6));
+        }
+        if tick == 64 * 50 {
+            let world = app.world_mut();
+            let pieces: Vec<Entity> = world
+                .query_filtered::<Entity, With<crate::debris::DebrisPiece>>()
+                .iter(world)
+                .collect();
+            if action == "force" || action == "force_sleep_vel" || action == "force_frozen_wake" {
+                if action == "force_frozen_wake" {
+                    avian3d::diag_rest::SKIP_FROZEN_WAKE.store(true, Relaxed);
+                }
+                if action == "force_sleep_vel" {
+                    avian3d::diag_rest::ZERO_SLEEP_VELOCITY.store(true, Relaxed);
+                }
+                for body in pieces {
+                    world
+                        .commands()
+                        .queue(avian3d::dynamics::solver::islands::SleepBody(body));
+                }
+                world.flush();
+            } else if action == "substeps" {
+                world.insert_resource(SubstepCount(24));
+            } else if action == "pose" {
+                world
+                    .resource_mut::<avian3d::physics_transform::PhysicsTransformConfig>()
+                    .transform_to_position = false;
+            } else if action == "threshold" {
+                for body in pieces {
+                    world.entity_mut(body).insert(SleepThreshold {
+                        linear: 0.15,
+                        angular: std::env::var("DIAG_ANGULAR")
+                            .unwrap_or("1.0".into())
+                            .parse()
+                            .unwrap(),
+                    });
+                }
+            }
+            println!("[DEBUG-rest] intervention {kind} {action} tick={tick}");
+        }
+        let start = std::time::Instant::now();
+        app.update();
+        tick_us.push(start.elapsed().as_secs_f64() * 1e6);
+        physics_us.push(app.world().resource::<DiagPhase>().us);
+        if tick % 64 == 63 {
+            let world = app.world_mut();
+            let bodies: Vec<_> = world.query::<(Entity,Has<crate::debris::DebrisPiece>,&LinearVelocity,&AngularVelocity,&SleepTimer,&BodyIslandNode,Has<Sleeping>,Has<SleepingDisabled>,&Position)>().iter(world)
+                .map(|(e,p,l,a,t,i,s,d,pos)| serde_json::json!({"e":format!("{e:?}"),"piece":p,"v":l.length(),"w":a.length(),"timer":t.0,"island":i.island_id().0,"sleep":s,"disabled":d,"position":pos.0.to_array()})).collect();
+            let awake = bodies
+                .iter()
+                .filter(|b| b["piece"] == true && b["sleep"] == false)
+                .count();
+            let asleep = bodies
+                .iter()
+                .filter(|b| b["piece"] == true && b["sleep"] == true)
+                .count();
+            tick_us.sort_by(f64::total_cmp);
+            physics_us.sort_by(f64::total_cmp);
+            let islands:Vec<_> = world.resource::<PhysicsIslands>().iter().map(|i|serde_json::json!({"id":i.id().0,"bodies":i.body_count(),"sleep":i.is_sleeping(),"removed":i.constraints_removed()})).collect();
+            println!(
+                "[DEBUG-rest] summary {}",
+                serde_json::json!({"kind":kind,"action":action,"tick":tick+1,"wall_s":wall.elapsed().as_secs_f64(),"awake":awake,"asleep":asleep,"tick_us":tick_us[tick_us.len()/2],"physics_us":physics_us[physics_us.len()/2],"weigh_calls":fracture::DIAG_WEIGH.swap(0,Relaxed),"weigh_us":fracture::DIAG_WEIGH_NS.swap(0,Relaxed) as f64/1e3})
+            );
+            println!(
+                "[DEBUG-rest] wake {}",
+                serde_json::json!({"tick":tick+1,"contact":avian3d::diag_rest::CONTACT.swap(0,Relaxed),"force":avian3d::diag_rest::FORCE.swap(0,Relaxed),"position":avian3d::diag_rest::POSITION.swap(0,Relaxed),"rotation":avian3d::diag_rest::ROTATION.swap(0,Relaxed),"velocity":avian3d::diag_rest::VELOCITY.swap(0,Relaxed),"timer":avian3d::diag_rest::TIMER.swap(0,Relaxed),"woken_bodies":avian3d::diag_rest::WOKEN.swap(0,Relaxed),"slept_bodies":avian3d::diag_rest::SLEPT.swap(0,Relaxed),"game":avian3d::diag_rest::GAME.swap(0,Relaxed)})
+            );
+            if tick % 640 == 639 || tick == 64 * 50 - 1 || tick == 64 * 50 + 63 {
+                println!(
+                    "[DEBUG-rest] bodies {}",
+                    serde_json::json!({"tick":tick+1,"kind":kind,"bodies":bodies,"islands":islands})
+                );
+            }
+            tick_us.clear();
+            physics_us.clear();
+        }
+    }
+}
