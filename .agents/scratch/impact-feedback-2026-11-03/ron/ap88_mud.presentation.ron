        flash_blue: ((0.08, 0.5), Taste("muzzle effects: ASSUMED provisional flash blue; world-space recipe, independent of viewer distance")),
        flash_heat: ((0.3, 0.7), Taste("muzzle effects: ASSUMED provisional flash heat; world-space recipe, independent of viewer distance")),
        blast_luma: ((0.18, 0.82), Taste("muzzle effects: ASSUMED provisional blast luma; world-space recipe, independent of viewer distance")),
        blast_green: ((0.18, 0.72), Taste("muzzle effects: ASSUMED provisional blast green; world-space recipe, independent of viewer distance")),
        blast_blue: ((0.03, 0.60), Taste("muzzle effects: ASSUMED provisional blast blue; world-space recipe, independent of viewer distance")),
        smoke_luma: ((0.16, 0.55), Taste("muzzle effects: ASSUMED provisional smoke luma; world-space recipe, independent of viewer distance")),
        smoke_red: (0.9, Taste("muzzle effects: ASSUMED provisional smoke red; world-space recipe, independent of viewer distance")),
        smoke_green: ((0.86, 0.55), Taste("muzzle effects: ASSUMED provisional smoke green; world-space recipe, independent of viewer distance")),
        smoke_warmth: (0.25, Taste("muzzle effects: ASSUMED provisional smoke warmth; world-space recipe, independent of viewer distance")),
        smoke_blue: (0.82, Taste("muzzle effects: ASSUMED provisional smoke blue; world-space recipe, independent of viewer distance")),
        smoke_cooling: (9.0, Taste("muzzle effects: ASSUMED provisional smoke cooling; world-space recipe, independent of viewer distance")),
        soil_shade: ((0.16, 0.84, 0.76, 0.24), Taste("muzzle effects: ASSUMED provisional soil shade; world-space recipe, independent of viewer distance")),
        flame_origin_fraction: (0.45, Taste("muzzle effects: ASSUMED provisional flame origin fraction; world-space recipe, independent of viewer distance")),
    ),
