// THROWAWAY design arm, case ap88_mud: the impact stills only, never shipped.
// The game's damage-model presentation, game state only. Required fields; no defaults.
(
    diagram: (
        lead_m: (1.5, Taste("damage-model diagram: ASSUMED metres of incoming line before contact")),
        run_out_m: (1.5, Taste("damage-model diagram: ASSUMED metres of outgoing line beyond the tank")),
        reach_calibres: (20.0, Taste("damage-model diagram: ASSUMED framing reach in calibres")),
        line_floor: (0.35, Taste("damage-model diagram: ASSUMED minimum line brightness for legibility")),
        field_note_px: (16.0, Taste("damage-model diagram: ASSUMED omission note font size in logical pixels")),
    ),
    impact: (
        debris_gravity: ((0.0, -9.81, 0.0), Derived("conventional standard gravity 9.80665 m/s2, rounded to 9.81; downward world Y")),
        dust_lifetime: ((0.5, 0.8), Taste("impact effects: ASSUMED how long a small read's powder hangs (s); never adjusted for viewer distance")),
        dust_size: ((0.35, 2.5), Taste("impact effects: ASSUMED a small read's puff, birth and end quad side (m), stated at impact_reference_energy_j. The visible mass spans about 60 % of the side (MEASURED: the sheet's cells hold signal above 0.15 over 0.5 to 0.7 of their side)")),
        dust_normal_push: (1.1, StandIn("impact effects: ASSUMED provisional dust normal push until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        dust_rise: (0.5, StandIn("impact effects: ASSUMED provisional dust rise until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        dust_alpha: (0.9, Taste("impact effects: ASSUMED a small read's opacity where its sheet saturates; world-space recipe, independent of viewer distance")),
        dust_frame_rate: (4.0, Taste("impact effects: ASSUMED provisional dust frame rate; world-space recipe, independent of viewer distance")),
        dust_spin_max: (0.8, Taste("impact effects: ASSUMED provisional dust spin max; world-space recipe, independent of viewer distance")),
        ping_lifetime: (0.045, StandIn("impact effects: ASSUMED provisional ping lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ping_size: (0.5, StandIn("impact effects: ASSUMED provisional ping size until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ping_glow: (13.0, Taste("impact effects: ASSUMED provisional ping glow; world-space recipe, independent of viewer distance")),
        spark_count: ((2, 4), StandIn("impact effects: ASSUMED provisional spark count until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spark_speed: ((10.0, 13.5), StandIn("impact effects: ASSUMED provisional spark speed until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spark_lifetime: ((0.4, 0.56), StandIn("impact effects: ASSUMED provisional spark lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spark_stretch: ((0.14, 0.2), StandIn("impact effects: ASSUMED provisional spark stretch until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spark_width_ratio: (1.2, Taste("impact effects: ASSUMED provisional spark width ratio; world-space recipe, independent of viewer distance")),
        spark_glow: (14.0, Taste("impact effects: ASSUMED provisional spark glow; world-space recipe, independent of viewer distance")),
        spark_spread: ((0.15, 0.9), Taste("impact effects: ASSUMED provisional spark spread; world-space recipe, independent of viewer distance")),
        ejecta_count: ((61, 61), StandIn("impact effects: ASSUMED provisional ejecta count until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ejecta_speed: ((7.3800, 12.3000), StandIn("impact effects: ASSUMED provisional ejecta speed until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ejecta_lifetime: ((2.0080, 2.5100), StandIn("impact effects: ASSUMED provisional ejecta lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ejecta_up_bias: (0.55, Taste("impact effects: ASSUMED provisional ejecta up bias; world-space recipe, independent of viewer distance")),
        ejecta_stretch: ((0.0545, 0.0817), StandIn("impact effects: ASSUMED provisional ejecta stretch until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ejecta_width_ratio: (6.0, Taste("impact effects: ASSUMED provisional ejecta width ratio; world-space recipe, independent of viewer distance")),
        splash_plume_count: ((3, 3), StandIn("impact effects: ASSUMED provisional splash plume count until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        splash_plume_size: ((2.3130, 7.7100), StandIn("impact effects: ASSUMED provisional splash plume size, stated at impact_reference_energy_j, until emitted material supplies the emission and settling laws; never adjusted for viewer distance")),
        splash_plume_aspect: ((1.5778, 2.2222, 1.0), Taste("impact effects: ASSUMED provisional splash plume aspect; world-space recipe, independent of viewer distance")),
        splash_plume_rise: (1.0751, StandIn("impact effects: ASSUMED provisional splash plume rise until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        splash_plume_lifetime: (2.5100, StandIn("impact effects: ASSUMED provisional splash plume lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        splash_ring_size: ((1.2, 8.0), StandIn("impact effects: ASSUMED provisional splash ring size, stated at impact_reference_energy_j, until emitted material supplies the emission and settling laws; never adjusted for viewer distance")),
        splash_ring_lifetime: (0.6, StandIn("impact effects: ASSUMED provisional splash ring lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        splash_ring_alpha: (0.0, Taste("impact effects: ASSUMED provisional splash ring alpha; world-space recipe, independent of viewer distance")),
        splash_ring_sharpness: (6.0, Taste("impact effects: ASSUMED provisional splash ring sharpness; world-space recipe, independent of viewer distance")),
        splash_cloud_size: ((7.7083, 15.4167), StandIn("impact effects: ASSUMED provisional splash cloud size, stated at impact_reference_energy_j, until emitted material supplies the emission and settling laws; never adjusted for viewer distance")),
        splash_cloud_lifetime: (7.2200, StandIn("impact effects: ASSUMED provisional splash cloud lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        splash_cloud_alpha: (0.0000, Taste("impact effects: ASSUMED provisional splash cloud alpha; world-space recipe, independent of viewer distance")),
        splash_cloud_rise: (0.35, StandIn("impact effects: ASSUMED provisional splash cloud rise until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        ground_mark_size: (2.2676, StandIn("impact effects: ASSUMED provisional ground mark size, stated at impact_reference_energy_j, until emitted material supplies the emission and crater laws")),
        ground_mark_lifetime: (60.0, StandIn("impact effects: ASSUMED provisional ground mark lifetime until a persistent terrain mark law replaces this fade")),
        scar_fade: ((0.0, 4.0, 0.0, 0.85), Taste("impact effects: ASSUMED the scar's frame, sharpness and opacity; world-space recipe, independent of viewer distance")),
        scar_end_scale: (1.0, Taste("impact effects: ASSUMED provisional scar growth over its life; world-space recipe, independent of viewer distance")),
        scar_shade: (0.45, Taste("impact effects: ASSUMED how much darker turned-up earth reads than the same soil in the air; scales the struck ground's lit colour rather than replacing it")),
        burst_flash_scale: (0.02, Taste("impact effects: ASSUMED flash metres per cube root of blast joule: scales the round's own burst energy, a blast's reach following its cube root. DERIVED at this scale, a blast of 1.5 MJ flashes about 2.3 m across")),
        burst_flash_lifetime: (0.04, Taste("impact effects: ASSUMED how long a burst's hot layer holds; shorter than a frame or two reads as a pop")),
        burst_flash_end_scale: (0.8, Taste("impact effects: ASSUMED the burst flash's size at the end of its life, as a share of its start")),
        armor_flash_size: (2.7, StandIn("impact effects: ASSUMED provisional armor flash size until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_flash_lifetime: (0.045, StandIn("impact effects: ASSUMED provisional armor flash lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_flash_glow: (13.0, Taste("impact effects: ASSUMED provisional armor flash glow; world-space recipe, independent of viewer distance")),
        armor_spark_count: ((14, 20), StandIn("impact effects: ASSUMED provisional armor spark count until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_spark_speed: ((10.0, 13.5), StandIn("impact effects: ASSUMED provisional armor spark speed until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_spark_lifetime: ((0.4, 0.56), StandIn("impact effects: ASSUMED provisional armor spark lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_spark_stretch: ((0.14, 0.2), StandIn("impact effects: ASSUMED provisional armor spark stretch until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        armor_spark_width_ratio: (1.2, Taste("impact effects: ASSUMED provisional armor spark width ratio; world-space recipe, independent of viewer distance")),
        armor_spark_glow: (14.0, Taste("impact effects: ASSUMED provisional armor spark glow; world-space recipe, independent of viewer distance")),
        armor_spark_spread: ((0.2, 1.1), Taste("impact effects: ASSUMED provisional armor spark spread; world-space recipe, independent of viewer distance")),
        armor_spark_deflect_bias: (0.6, Taste("impact effects: ASSUMED provisional armor spark deflect bias; world-space recipe, independent of viewer distance")),
        spall_puff_size: ((0.4, 1.3), StandIn("impact effects: ASSUMED provisional spall puff size until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spall_puff_lifetime: ((0.22, 0.38), StandIn("impact effects: ASSUMED provisional spall puff lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spall_puff_alpha: (0.5, Taste("impact effects: ASSUMED provisional spall puff alpha; world-space recipe, independent of viewer distance")),
        spall_puff_rise: (0.6, StandIn("impact effects: ASSUMED provisional spall puff rise until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        flame_lick_size: ((1.5, 0.8), StandIn("impact effects: ASSUMED provisional flame lick size until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        flame_lick_lifetime: (0.12, StandIn("impact effects: ASSUMED provisional flame lick lifetime until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        flame_lick_glow: (8.0, Taste("impact effects: ASSUMED provisional flame lick glow; world-space recipe, independent of viewer distance")),
        flame_lick_rise: (1.2, StandIn("impact effects: ASSUMED provisional flame lick rise until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        dust_sharpness: (14.0, Taste("impact effects: ASSUMED how fast a small read's signal saturates its alpha. MEASURED on impact_dust.png as the shader samples it (sRGB decoded red x alpha): the three powder cells' signal has p99 0.29 to 0.38 and max 0.43 to 0.52, so a sharpness of 1 would never reach full cover")),
        ejecta_sharpness: (3.0, Taste("impact effects: ASSUMED how hard-edged a thrown clod's sprite reads; world-space recipe, independent of viewer distance")),
        ejecta_spread: ((0.15, 0.9), Taste("impact effects: ASSUMED the spread of thrown clods around their up-biased axis; world-space recipe, independent of viewer distance")),
        spark_sharpness: (3.0, Taste("impact effects: ASSUMED provisional spark sharpness; world-space recipe, independent of viewer distance")),
        splash_plume_sharpness: (14.0, Taste("impact effects: ASSUMED how fast a plume's signal saturates its alpha, so the column reads as a mass. MEASURED on impact_dust.png as the shader samples it (sRGB decoded red x alpha): the three powder cells' signal has p99 0.29 to 0.38 and max 0.43 to 0.52; at 2.2 its cover averaged under 10 % of the quad, and it read as a thin dark smudge")),
        flash_sharpness: (2.0, Taste("impact effects: ASSUMED provisional flash sharpness; world-space recipe, independent of viewer distance")),
        powder_luma: ((0.2, 0.8), Taste("impact effects: ASSUMED provisional powder luma; world-space recipe, independent of viewer distance")),
        spark_green: ((0.55, 0.35), Taste("impact effects: ASSUMED provisional spark green; world-space recipe, independent of viewer distance")),
        spark_blue: ((0.12, 0.5), Taste("impact effects: ASSUMED provisional spark blue; world-space recipe, independent of viewer distance")),
        spark_heat: ((0.35, 0.65), Taste("impact effects: ASSUMED provisional spark heat; world-space recipe, independent of viewer distance")),
        hot_green: ((0.35, 0.6), Taste("impact effects: ASSUMED provisional hot green; world-space recipe, independent of viewer distance")),
        hot_blue: ((0.05, 0.65), Taste("impact effects: ASSUMED provisional hot blue; world-space recipe, independent of viewer distance")),
        hot_heat: ((0.35, 0.95), Taste("impact effects: ASSUMED provisional hot heat; world-space recipe, independent of viewer distance")),
        surface_clearance_m: (0.05, Resolution("impact effects: the lift of a flat small quad off its surface (m): enough to clear depth fighting across a battlefield's depth precision; states no world fact and is never adjusted for viewer distance")),
        wide_quad_clearance_m: (0.1, Resolution("impact effects: the lift of a wide flat or hot quad off its surface (m): a wider quad on rough ground needs more to clear depth fighting; states no world fact and is never adjusted for viewer distance")),
        ping_end_scale: (0.7, Taste("impact effects: ASSUMED provisional ping end scale; world-space recipe, independent of viewer distance")),
        spark_end_scale: (0.8, Taste("impact effects: ASSUMED provisional spark end scale; world-space recipe, independent of viewer distance")),
        ejecta_end_scale: (1.0, Taste("impact effects: ASSUMED provisional ejecta end scale; world-space recipe, independent of viewer distance")),
        plume_alpha: (0.8079, Taste("impact effects: ASSUMED provisional plume alpha; world-space recipe, independent of viewer distance")),
        plume_roll_rad: (0.2, Taste("impact effects: ASSUMED provisional plume roll rad; world-space recipe, independent of viewer distance")),
        cloud_lift_m: (0.5, StandIn("impact effects: ASSUMED provisional cloud lift m until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        flash_end_scale: (0.8, Taste("impact effects: ASSUMED provisional flash end scale; world-space recipe, independent of viewer distance")),
        spall_push_mps: (0.3, StandIn("impact effects: ASSUMED provisional spall push mps until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        flame_push_mps: (0.5, StandIn("impact effects: ASSUMED provisional flame push mps until resolved contact energy and emitted material supply the emission and settling laws; never adjusted for viewer distance")),
        spall_sharpness: (8.0, Taste("impact effects: ASSUMED provisional spall sharpness; world-space recipe, independent of viewer distance")),
        soft_particle_depth: (0.75, Taste("impact effects: ASSUMED provisional soft particle depth; world-space recipe, independent of viewer distance")),
        splash_cloud_sharpness: (8.0, Taste("impact effects: ASSUMED how fast the lingering cloud's signal saturates its alpha: softer than the plume, so it thins as a haze rather than floating as a hard blob")),
        impact_reference_energy_j: (3.0e6, Taste("impact effects: ASSUMED a round 3 MJ: the large-calibre strikes the plume's band describes (ADR-0023). Every length of a contact read is stated at this energy")),
        impact_size_exponent: (0.000001, Taste("impact effects: ASSUMED a contact read's lengths grow with the sixth root of its round's energy, half the cube root's rate, so a rifle round's puff still reads beside an 88 mm's")),
        powder_erosion_end: (0.4, Taste("impact effects: ASSUMED the erosion threshold a powder mass reaches at the end of its life: the dust sheet's own signal ceiling. MEASURED on impact_dust.png as the shader samples it (sRGB decoded red x alpha): the three powder cells' signal has p99 0.29 to 0.38 and max 0.43 to 0.52, so a ramp to 1.0 erased a plume by 30 % of its life, 0.45 s of its 1.5 s, against ADR-0023's 1.5 to 2 s hang")),
        scar_erosion_end: (0.4, Taste("impact effects: ASSUMED the erosion threshold a ground scar reaches at the end of its life: its clod cell's p99 signal is 0.6 (MEASURED as powder_erosion_end), so a clump outlasts the patch")),
        streak_erosion_end: (0.8, Taste("impact effects: ASSUMED the erosion threshold a streak on the spark sheet reaches at the end of its life: dissolved exactly at despawn")),
        flame_erosion_end: (1.0, Taste("impact effects: ASSUMED the erosion threshold a flame lick reaches at the end of its life: it collapses inside its short life")),
    ),
    muzzle: (
        blast_erosion: (0.3, Taste("muzzle effects: ASSUMED erosion threshold at the fireball's death. Low, unlike every other muzzle layer: the sheet already animates its own dissolution, and the die-off is the blast palette's cooling term, which reaches black at the last row, so the layer is gone before it despawns. Erosion here only thins the fringe; ramped to 1.0 it eats the fireball into confetti through the middle of the sequence")),
        smoke_frame_rate: (5.0, Taste("muzzle effects: ASSUMED provisional smoke frame rate; world-space recipe, independent of viewer distance")),
        smoke_spin_max: (0.6, Taste("muzzle effects: ASSUMED provisional smoke spin max; world-space recipe, independent of viewer distance")),
        ground_dust_frame_rate: (3.0, Taste("muzzle effects: ASSUMED provisional ground dust frame rate; world-space recipe, independent of viewer distance")),
        ground_dust_spin_max: (0.35, Taste("muzzle effects: ASSUMED provisional ground dust spin max; world-space recipe, independent of viewer distance")),
        ground_dust_erosion_end: (0.5, Taste("muzzle effects: ASSUMED the erosion threshold a dust puff reaches at the end of its life: the dust sheet's own signal ceiling, so a puff dissolves over its whole resolved lifetime. MEASURED on impact_dust.png as the shader samples it (sRGB decoded red x alpha): the powder cells' signal has p99 0.29 to 0.38 and max 0.43 to 0.52, so a ramp to 1.0 passes that p99 at 30 to 38 % of a puff's life and a ramp to 0.5 at 60 to 76 %")),
        far_full_dressing: (400.0, Resolution("muzzle effects: beyond this camera distance (m) only the core, the fireball and the light spawn: a cost bound on near-field overdraw. It skips layers and never changes the size of a drawn one")),
        shadow_read_window_s: (0.1, Taste("muzzle effects: ASSUMED shadow-read window (s): a persistent light or an isolated flash casts; repeated flashes shorter than this do not. MEASURED evidence for the short and repeating regime: scripts/perf/run-fire-capture.sh, M4, two tanks, M350, vsync off: firing with shadows moved p50 from 13.5 to 15.5 ms, without from 13.5 to 14.6 ms. DERIVED at the fixture's combined rate of 25/s and 0.05 s life, each cubemap lasts about three 60 Hz frames. This window is a presentation policy, not a measured perceptual threshold")),
        flash_floor: (0.17, Taste("muzzle effects: ASSUMED provisional flash floor; world-space recipe, independent of viewer distance")),
        blast_floor: ((0.04, 0.28), Taste("muzzle effects: ASSUMED provisional blast floor; world-space recipe, independent of viewer distance")),
        blast_hot: (0.35, Taste("muzzle effects: ASSUMED provisional blast hot; world-space recipe, independent of viewer distance")),
        blast_cool: (0.25, Taste("muzzle effects: ASSUMED provisional blast cool; world-space recipe, independent of viewer distance")),
        flash_red: ((0.9, 0.1), Taste("muzzle effects: ASSUMED provisional flash red; world-space recipe, independent of viewer distance")),
