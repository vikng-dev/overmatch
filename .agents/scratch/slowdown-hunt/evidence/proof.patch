+        app.update();
+        assert!(
+            app.world()
+                .resource::<ContactGraph>()
+                .get(support, resting)
+                .is_some_and(|(edge, _)| edge.is_touching()),
+            "the new stationary support must reach the sleeping body"
+        );
+        assert!(
+            app.world().get::<Sleeping>(resting).is_some(),
+            "a contact with no awake non-static participant supplies no wake"
+        );
+    }
 }
