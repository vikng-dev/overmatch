+// [DEBUG-hunt] Temporary video-game environment destruction counters.
+pub(crate) mod diag_hunt {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub const N: usize = 10;
+    pub static CALLS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    pub static NS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    pub static CHANGED: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    pub static CONTACT: AtomicU64 = AtomicU64::new(0);
+    pub static FIELD: AtomicU64 = AtomicU64::new(0);
+    pub static SPLIT: AtomicU64 = AtomicU64::new(0);
+    pub struct Span(usize, std::time::Instant);
+    impl Span {
+        pub fn new(i: usize) -> Self {
+            CALLS[i].fetch_add(1, Relaxed);
+            Self(i, std::time::Instant::now())
+        }
+    }
+    impl Drop for Span {
+        fn drop(&mut self) {
+            NS[self.0].fetch_add(self.1.elapsed().as_nanos() as u64, Relaxed);
+        }
+    }
+    pub fn changed(i: usize, changed: bool) {
+        CHANGED[i].fetch_add(u64::from(changed), Relaxed);
+    }
+    pub fn snapshot() -> serde_json::Value {
+        serde_json::json!({"names":["apply","laws","strike","structural","weigh","fall","loose_groups","incident","held","in_group_frames"],
+        "calls":CALLS.each_ref().map(|c|c.swap(0,Relaxed)), "ns":NS.each_ref().map(|c|c.swap(0,Relaxed)),
+        "changed":CHANGED.each_ref().map(|c|c.swap(0,Relaxed)),
+        "contact_runs":CONTACT.swap(0,Relaxed),"field_runs":FIELD.swap(0,Relaxed),"splits":SPLIT.swap(0,Relaxed)})
+    }
+}
+
+// [DEBUG-hunt] Real server rubble census; no interventions.
+pub(crate) fn diag_server(
+    mut last: Local<Option<std::time::Instant>>,
+    mut elapsed: Local<u64>,
+    bodies: Query<
+        (
+            Entity,
+            &LinearVelocity,
+            &AngularVelocity,
+            &avian3d::prelude::SleepTimer,
+            &avian3d::dynamics::solver::islands::BodyIslandNode,
+            Has<avian3d::prelude::Sleeping>,
+            Has<avian3d::prelude::SleepingDisabled>,
+        ),
+        With<crate::debris::DebrisPiece>,
+    >,
+    islands: Res<avian3d::dynamics::solver::islands::PhysicsIslands>,
+    buildings: Query<Entity, With<super::BuildingBody>>,
+    mut commands: Commands,
+) {
+    let now = std::time::Instant::now();
+    let previous = last.get_or_insert(now);
+    if now.duration_since(*previous).as_secs_f64() < 1.0 {
+        return;
+    }
+    let seconds = now.duration_since(*previous).as_secs_f64();
+    *previous = now;
+    *elapsed += 1;
+    if *elapsed == 20 && std::env::var("DIAG_REMOVE_BUILDINGS").is_ok() {
+        println!(
+            "[DEBUG-hunt] removing {} standing buildings",
+            buildings.iter().count()
+        );
+        for root in &buildings {
+            commands.entity(root).despawn();
+        }
+    }
+    let mut result = diag_hunt::snapshot();
+    result["period_s"] = seconds.into();
+    if (*elapsed).is_multiple_of(10) {
+        result["bodies"]=serde_json::json!(bodies.iter().map(|(e,l,a,t,i,s,d)|serde_json::json!({"e":format!("{e:?}"),"v":l.length(),"w":a.length(),"timer":t.0,"island":i.island_id().0,"sleep":s,"disabled":d})).collect::<Vec<_>>());
+        result["islands"]=serde_json::json!(islands.iter().map(|i|serde_json::json!({"id":i.id().0,"bodies":i.body_count(),"sleep":i.is_sleeping(),"removed":i.constraints_removed()})).collect::<Vec<_>>());
+    }
+    println!("[DEBUG-hunt] {result}");
+}
