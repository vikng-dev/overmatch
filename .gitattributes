*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
# Terrain: the world heightmaps at the root (PNG), plus one folder per surface texture pack
# holding its KTX2 maps (assets/terrain/<pack>/<pack>_{diff|col,nor_gl,arm}.ktx2, built by
# scripts/encode-terrain-ktx2.sh). `**/` matches zero or more directories, so these patterns cover
# BOTH the root files and every pack folder — a pack added without touching this file is still
# LFS-tracked. The jpg line stays for any future non-terrain-pack image dropped in here.
assets/terrain/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/terrain/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/terrain/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
